<div class="modal fade" id="applicationDialogModal" tabindex="-1" aria-labelledby="applicationDialogModalTitle" aria-describedby="applicationDialogModalMessage" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="applicationDialogModalTitle"></h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-start">
                <p class="mb-0" id="applicationDialogModalMessage"></p>
            </div>
            <div class="modal-footer" id="applicationDialogModalFooter">
                <button type="button" class="btn btn-secondary" id="applicationDialogModalCancelButton" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="applicationDialogModalActionButton">Confirm</button>
            </div>
        </div>
    </div>
</div>
