<div class="modal fade" id="passwordResetModal" tabindex="-1" aria-labelledby="passwordResetModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="passwordResetModalTitle">Create password reset</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-start">
                <form id="passwordResetForm">
                    <div id="passwordResetCreationForm">
                        <label class="form-label" for="passwordResetUser">User</label>
                        <select class="form-select" id="passwordResetUser" required>
                            <option value="" selected disabled>Select a user</option>
                            {% for user in users %}
                                <option value="{{ user.id }}" data-user-name="{{ user.name }}">{{ user.name }} ({{ user.email }})</option>
                            {% endfor %}
                        </select>
                        <div class="form-text">A password reset email will be sent to the selected user.</div>
                    </div>
                </form>

                <div class="d-none" id="passwordResetDetails">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">User</dt>
                        <dd class="col-sm-8" id="passwordResetDetailsUser"></dd>
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8" id="passwordResetDetailsEmail"></dd>
                        <dt class="col-sm-4">Created</dt>
                        <dd class="col-sm-8" id="passwordResetDetailsCreatedAt"></dd>
                        <dt class="col-sm-4">Expires</dt>
                        <dd class="col-sm-8" id="passwordResetDetailsExpiresAt"></dd>
                    </dl>
                </div>

                <div class="alert alert-danger d-none mt-3 mb-0" role="alert" id="passwordResetModalError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger d-none" id="revokePasswordResetButton" onclick="revokePasswordReset()">Revoke</button>
                <button type="button" class="btn btn-primary d-none" id="resendPasswordResetButton" onclick="resendPasswordReset()">Resend email</button>
                <button type="submit" class="btn btn-primary" id="createPasswordResetButton" form="passwordResetForm">Send email</button>
            </div>
        </div>
    </div>
</div>
