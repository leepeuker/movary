<div class="modal fade" id="changePosterModal" tabindex="-1" aria-labelledby="changePosterModalTitle" aria-hidden="true" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="changePosterModalTitle">Change poster</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="posterSelectionLoading" class="text-center py-4">
                    <div class="spinner-border" role="status"><span class="visually-hidden">Loading posters</span></div>
                </div>
                <div id="posterSelectionError" class="alert alert-danger d-none" role="alert">Could not load posters from TMDB.</div>
                <div id="posterSelectionEmpty" class="text-center py-4 d-none">No English posters are available for this movie.</div>
                <div id="posterSelectionGrid" class="row row-cols-2 row-cols-sm-3 row-cols-md-4 g-3"></div>
                <div class="text-center mt-3">
                    <button type="button" class="btn btn-outline-secondary d-none" id="showMorePostersButton">Show more</button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger d-none" id="restoreDefaultPosterButton">Restore TMDB default</button>
                <button type="button" class="btn btn-primary" id="useSelectedPosterButton" disabled>Use selected poster</button>
            </div>
        </div>
    </div>
</div>
