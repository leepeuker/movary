<div class="modal fade" id="jobScheduleModal" tabindex="-1" aria-labelledby="jobScheduleModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="jobScheduleForm">
                <input type="hidden" name="scheduleMode" value="recurring">
                <div class="modal-header">
                    <h5 class="modal-title" id="jobScheduleModalTitle"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-start">
                    <div class="mb-3">
                        <label class="form-label" for="jobScheduleType">Job type</label>
                        <select class="form-select" id="jobScheduleType" name="jobType">
                            <option value="tmdb_movie_sync">TMDB movie metadata sync</option>
                            <option value="tmdb_person_sync">TMDB person metadata sync</option>
                            <option value="tmdb_image_cache">TMDB image cache refresh</option>
                            <option value="imdb_sync">IMDb ratings sync</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="jobScheduleCronExpression">Cron expression (UTC)</label>
                        <input class="form-control font-monospace" id="jobScheduleCronExpression" name="cronExpression" value="0 * * * *" list="jobScheduleCronPresets" autocomplete="off" required>
                        <datalist id="jobScheduleCronPresets">
                            <option value="* * * * *">Every minute</option>
                            <option value="0 * * * *">Hourly</option>
                            <option value="0 0 * * *">Daily at midnight</option>
                            <option value="0 0 * * 0">Weekly on Sunday</option>
                            <option value="0 0 1 * *">Monthly on the first day</option>
                        </datalist>
                        <div class="form-text">Five fields: minute, hour, day of month, month, day of week.</div>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" id="jobScheduleEnabled" name="enabled" type="checkbox" value="1" checked>
                        <label class="form-check-label" for="jobScheduleEnabled">Enabled</label>
                    </div>

                    <hr>

                    <div data-job-schedule-fields="tmdb_movie_sync">
                        {{ include('component/job-form-tmdb-sync.html.twig', {
                            idPrefix: 'tmdbMovieJobSchedule',
                            resourceName: 'movie',
                        }) }}
                    </div>
                    <div class="d-none" data-job-schedule-fields="tmdb_person_sync">
                        {{ include('component/job-form-tmdb-sync.html.twig', {
                            idPrefix: 'tmdbPersonJobSchedule',
                            resourceName: 'person',
                        }) }}
                    </div>
                    <div class="d-none" data-job-schedule-fields="tmdb_image_cache">
                        {{ include('component/job-form-tmdb-image-cache.html.twig', {
                            idPrefix: 'tmdbImageCacheJobSchedule',
                        }) }}
                    </div>
                    <div class="d-none" data-job-schedule-fields="imdb_sync">
                        {{ include('component/job-form-tmdb-sync.html.twig', {
                            idPrefix: 'imdbRatingsJobSchedule',
                            resourceName: 'movie',
                        }) }}
                    </div>

                    <div class="alert alert-danger d-none mb-0" role="alert" id="jobScheduleModalError"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger d-none" id="jobScheduleDeleteButton" onclick="removeSelectedJobSchedule()">Delete</button>
                    <button type="submit" class="btn btn-primary" id="jobScheduleSubmitButton"></button>
                </div>
            </form>
        </div>
    </div>
</div>
