<div class="mb-3">
    <label class="form-label" for="{{ idPrefix }}MovieIds">Local movie IDs</label>
    <input class="form-control" id="{{ idPrefix }}MovieIds" name="movieIds" type="text" inputmode="numeric" placeholder="For example: 12, 34, 56">
    <div class="form-text">Cache each movie and its cast and crew images.</div>
</div>
<div class="mb-3">
    <label class="form-label" for="{{ idPrefix }}PersonIds">Local person IDs</label>
    <input class="form-control" id="{{ idPrefix }}PersonIds" name="personIds" type="text" inputmode="numeric" placeholder="For example: 12, 34, 56">
    <div class="form-text">Cache these person images. At least one movie or person ID is required.</div>
</div>
