{% macro create(dashboardRow, lastPlaysCinema, routeUsername) %}

    {% import 'component/dashboard/row-item-toggle.html.twig' as rowItemToggle %}
    {{ rowItemToggle.create(dashboardRow) }}

    <li class="list-group-item {{ dashboardRow.isExtended ? 'activeItem' : 'inactiveItem' }}" style="padding: 1rem 0.4rem 0 0.4rem;">
        <div class="poster-grid row row-cols-3 row-cols-md-3 row-cols-lg-5 row-cols-xxl-6">
            {% for lastPlay in lastPlaysCinema %}
                <div class="col">
                    <div class="card h-100">
                        <a class="poster-link d-block h-100 position-relative" href="{{ applicationUrl }}/users/{{ routeUsername }}/movies/{{ lastPlay.id }}-{{ lastPlay.title|slugify }}">
                            <img src="{{ lastPlay.poster_path }}"
                                 class="card-img-top object-fit-cover h-100"
                                 alt="{{ lastPlay.title }} Poster">

                            {% if lastPlay.user_rating is not null %}
                                <span class="poster-rating position-absolute badge rounded-pill bg-warning text-dark">
                                    {{ lastPlay.user_rating }}
                                </span>
                            {% endif %}
                        </a>
                        <div class="poster-footer card-footer">
                            <small class="text-muted" style="font-size: 0.8rem;">{{ lastPlay.watched_at|date(dateFormatPhp) }}</small>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        <a class="btn btn-outline-secondary btn-sm mt-3" href="{{ applicationUrl }}/users/{{ routeUsername }}/history" style="margin-bottom: 1rem;width: 100%;border-color: lightgrey">more</a>
    </li>
{% endmacro %}
