{% macro create(dashboardRow, personalRatingDistribution, routeUsername) %}

    {% import 'component/dashboard/row-item-toggle.html.twig' as rowItemToggle %}
    {{ rowItemToggle.create(dashboardRow) }}

    {% set maxCount = 1 %}
    {% for rating in personalRatingDistribution %}
        {% set maxCount = max(maxCount, rating.count) %}
    {% endfor %}

    <li class="list-group-item {{ dashboardRow.isExtended ? 'activeItem' : 'inactiveItem' }}" style="padding: 1rem;">
        <div class="rating-distribution-chart">
            {% for rating in personalRatingDistribution %}
                <div class="rating-distribution-column">
                    <div class="rating-distribution-bar-area">
                        {% if rating.count > 0 %}
                            <a class="rating-distribution-bar rating-distribution-bar-visible"
                               aria-label="View {{ rating.count }} {{ rating.count == 1 ? 'movie' : 'movies' }} rated {{ rating.rating }} out of 10"
                               data-count="Count: {{ rating.count }}"
                               href="{{ applicationUrl }}/users/{{ routeUsername }}/movies?sb=title&amp;so=asc&amp;pp=24&amp;ur=1&amp;minur={{ rating.rating }}&amp;maxur={{ rating.rating }}"
                               style="height: {{ rating.count / maxCount * 100 }}%"></a>
                        {% else %}
                            <div class="rating-distribution-bar" style="height: 0"></div>
                        {% endif %}
                    </div>
                    <span class="rating-distribution-label">
                        {{ rating.rating }}
                        <span class="visually-hidden">out of 10: {{ rating.count }} {{ rating.count == 1 ? 'rating' : 'ratings' }}</span>
                    </span>
                </div>
            {% endfor %}
        </div>
    </li>
{% endmacro %}
