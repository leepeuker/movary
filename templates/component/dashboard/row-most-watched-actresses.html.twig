{% macro create(dashboardRow, mostWatchedActresses, routeUsername) %}

    {% import 'component/dashboard/row-item-toggle.html.twig' as rowItemToggle %}
    {{ rowItemToggle.create(dashboardRow) }}

    <li class="list-group-item {{ dashboardRow.isExtended ? 'activeItem' : 'inactiveItem' }}" style="padding: 1rem 0.4rem 0 0.4rem;">
        <div class="poster-grid row row-cols-3 row-cols-md-3 row-cols-lg-5 row-cols-xxl-6">
            {% for mostWatchedActress in mostWatchedActresses %}
                <div class="col">
                    <div class="card h-100 position-relative">
                        <div class="card-header text-truncate" style="padding: 0.2rem">
                            <small class="text-muted" style="font-size: 0.9rem;">{{ mostWatchedActress.name }}</small>
                        </div>
                        <input id="actorName_{{ mostWatchedActress.id }}" value="{{ mostWatchedActress.name }}" type="hidden">
                        <a class="poster-link d-block" href="{{ applicationUrl }}/users/{{ routeUsername }}/persons/{{ mostWatchedActress.id }}-{{ mostWatchedActress.name|slugify }}">
                            <img style="max-width: 100%" src="{{ mostWatchedActress.poster_path }}" alt="{{ mostWatchedActress.name }} Poster">
                        </a>
                        <div class="poster-footer card-footer">
                            <small class="text-muted" style="font-size: 0.9rem;">{{ mostWatchedActress.uniqueCount }}x</small>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        <a class="btn btn-outline-secondary btn-sm mt-3" href="{{ applicationUrl }}/users/{{ routeUsername }}/actors?s=&sb=uniqueAppearances&so=desc&ge=1&pp=24"
           style="margin-bottom: 1rem;width: 100%;border-color: lightgrey">more</a>
    </li>
{% endmacro %}
