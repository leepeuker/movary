{% macro create(dashboardRow, watchlistItems, routeUsername) %}

    {% import 'component/dashboard/row-item-toggle.html.twig' as rowItemToggle %}
    {{ rowItemToggle.create(dashboardRow) }}

    <li class="dashboard-poster-row list-group-item {{ dashboardRow.isExtended ? 'activeItem' : 'inactiveItem' }}">
        <div class="poster-grid row row-cols-3 row-cols-lg-6">
            {% for watchlistItem in watchlistItems %}
                <div class="col">
                    <div class="card h-100 position-relative">
                        <a class="poster-link d-block h-100" href="{{ applicationUrl }}/users/{{ routeUsername }}/movies/{{ watchlistItem.id }}-{{ watchlistItem.title|slugify }}">
                            <img src="{{ watchlistItem.poster_path }}"
                                 class="card-img-top object-fit-cover h-100"
                                 alt="{{ watchlistItem.title|movie_title(watchlistItem.original_title) }} Poster">
                        </a>
                        <div class="poster-footer card-footer">
                            <small class="dashboard-card-text text-muted">{{ watchlistItem.created_at|date(dateFormatPhp) }}</small>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        <a class="dashboard-row-more" href="{{ applicationUrl }}/users/{{ routeUsername }}/watchlist">View all</a>
    </li>
{% endmacro %}
