{% macro create(dashboardRow, lastPlays, routeUsername) %}

    {% import 'component/dashboard/row-item-toggle.html.twig' as rowItemToggle %}
    {{ rowItemToggle.create(dashboardRow) }}

    <li class="dashboard-poster-row list-group-item {{ dashboardRow.isExtended ? 'activeItem' : 'inactiveItem' }}">
        <div class="poster-grid row row-cols-3 row-cols-lg-6">
            {% for lastPlay in lastPlays %}
                <div class="col">
                    <div class="card h-100">
                        <a class="poster-link d-block h-100 position-relative" href="{{ applicationUrl }}/users/{{ routeUsername }}/movies/{{ lastPlay.id }}-{{ lastPlay.title|slugify }}">
                            <img src="{{ lastPlay.poster_path }}"
                                 class="card-img-top object-fit-cover h-100"
                                 alt="{{ lastPlay.title|movie_title(lastPlay.original_title) }} Poster">

                            {% if lastPlay.user_rating is not null %}
                                <span class="poster-rating position-absolute badge rounded-pill bg-warning text-dark">
                                    {{ lastPlay.user_rating }}
                                </span>
                            {% endif %}
                        </a>
                        <div class="poster-footer card-footer">
                            <small class="dashboard-play-date text-muted">{{ lastPlay.watched_at|date(dateFormatPhp) }}</small>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        <a class="dashboard-row-more btn btn-outline-secondary btn-sm mt-3" href="{{ applicationUrl }}/users/{{ routeUsername }}/history">more</a>
    </li>
{% endmacro %}
