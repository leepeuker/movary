<div class="modal fade" id="createJobModal" tabindex="-1" aria-labelledby="createJobModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="createJobForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="createJobModalTitle">Create Job</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-start">
                    <div class="mb-3">
                        <label class="form-label" for="createJobType">Job type</label>
                        <select class="form-select" id="createJobType" name="jobType">
                            <option value="tmdb_movie_sync">TMDB movie metadata sync</option>
                            <option value="tmdb_person_sync">TMDB person metadata sync</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="createJobScheduleMode">Schedule</label>
                        <select class="form-select" id="createJobScheduleMode" name="scheduleMode">
                            <option value="once">Run once</option>
                            <option value="recurring">Recurring (cron)</option>
                        </select>
                    </div>
                    <div class="d-none mb-3" id="createJobCronFields">
                        <label class="form-label" for="createJobCronExpression">Cron expression (UTC)</label>
                        <input class="form-control font-monospace" id="createJobCronExpression" name="cronExpression" value="0 * * * *" list="createJobCronPresets" autocomplete="off">
                        <datalist id="createJobCronPresets">
                            <option value="* * * * *">Every minute</option>
                            <option value="0 * * * *">Hourly</option>
                            <option value="0 0 * * *">Daily at midnight</option>
                            <option value="0 0 * * 0">Weekly on Sunday</option>
                            <option value="0 0 1 * *">Monthly on the first day</option>
                        </datalist>
                        <div class="form-text">Five fields: minute, hour, day of month, month, day of week.</div>
                    </div>
                    <div class="alert alert-warning d-none" id="createJobCronWarning" role="alert">
                        Cron schedules can run as often as once per minute and create sustained TMDB API load. An occurrence is skipped while the same job type is active.
                    </div>

                    <div data-job-fields="tmdb_movie_sync">
                        {{ include('component/job-form-tmdb-sync.html.twig', {
                            idPrefix: 'tmdbMovieJob',
                            resourceName: 'movie',
                        }) }}
                    </div>
                    <div class="d-none" data-job-fields="tmdb_person_sync">
                        {{ include('component/job-form-tmdb-sync.html.twig', {
                            idPrefix: 'tmdbPersonJob',
                            resourceName: 'person',
                        }) }}
                    </div>

                    <div class="alert alert-danger d-none mb-0" role="alert" id="createJobError"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="createJobSubmitButton">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>
