<div class="modal fade" id="createJobModal" tabindex="-1" aria-labelledby="createJobModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="createJobForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="createJobModalTitle">Create Job</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-start">
                    <div class="mb-3">
                        <label class="form-label" for="createJobType">Job type</label>
                        <select class="form-select" id="createJobType" name="jobType">
                            <option value="tmdb_movie_sync">TMDB movie metadata sync</option>
                            <option value="tmdb_person_sync">TMDB person metadata sync</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="createJobFrequency">Frequency</label>
                        <select class="form-select" id="createJobFrequency" name="frequency">
                            <option value="once">Run once</option>
                            <option value="minutely">Every minute</option>
                            <option value="hourly">Hourly</option>
                            <option value="daily">Daily</option>
                            <option value="weekly">Weekly</option>
                            <option value="monthly">Monthly</option>
                        </select>
                    </div>
                    <div class="d-none mb-3" id="createJobFirstRunFields">
                        <label class="form-label" for="createJobFirstRunAt">First run</label>
                        <input class="form-control" id="createJobFirstRunAt" type="datetime-local">
                        <div class="form-text">Entered in your local time and stored as UTC.</div>
                    </div>
                    <div class="alert alert-warning d-none" id="createJobFrequencyWarning" role="alert">
                        Running every minute can create sustained TMDB API load. An occurrence is skipped while the same job type is active.
                    </div>

                    <div data-job-fields="tmdb_movie_sync">
                        {{ include('component/job-form-tmdb-sync.html.twig', {
                            idPrefix: 'tmdbMovieJob',
                            resourceName: 'movie',
                        }) }}
                    </div>
                    <div class="d-none" data-job-fields="tmdb_person_sync">
                        {{ include('component/job-form-tmdb-sync.html.twig', {
                            idPrefix: 'tmdbPersonJob',
                            resourceName: 'person',
                        }) }}
                    </div>

                    <div class="alert alert-danger d-none mb-0" role="alert" id="createJobError"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="createJobSubmitButton">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>
