<div class="modal fade" id="jobFiltersModal" tabindex="-1" aria-labelledby="jobFiltersModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="jobFiltersModalTitle">Filter jobs</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-start">
                <div class="input-group mb-3">
                    <label class="input-group-text" for="jobFilterUser">User</label>
                    <select class="form-select" id="jobFilterUser">
                        <option value="" {{ jobFilterUser is null ? 'selected' }}>All users</option>
                        <option value="none" {{ jobFilterUser == 'none' ? 'selected' }}>No user</option>
                        {% for user in users %}
                            <option value="{{ user.id }}" {{ jobFilterUser == user.id ? 'selected' }}>{{ user.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="input-group mb-3">
                    <label class="input-group-text" for="jobFilterType">Type</label>
                    <select class="form-select" id="jobFilterType">
                        <option value="" {{ jobFilterType is null ? 'selected' }}>All types</option>
                        {% for jobType in jobTypes %}
                            <option value="{{ jobType }}" {{ jobFilterType == jobType ? 'selected' }}>{{ jobType }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="input-group">
                    <label class="input-group-text" for="jobFilterStatus">Status</label>
                    <select class="form-select" id="jobFilterStatus">
                        <option value="" {{ jobFilterStatus is null ? 'selected' }}>All statuses</option>
                        {% for jobStatus in jobStatuses %}
                            <option value="{{ jobStatus }}" {{ jobFilterStatus == jobStatus ? 'selected' }}>{{ jobStatus }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <button class="btn btn-warning" type="button" onclick="resetJobFilters()">Reset</button>
                <button class="btn btn-primary" type="button" onclick="applyJobFilters()">Apply filters</button>
            </div>
        </div>
    </div>
</div>
