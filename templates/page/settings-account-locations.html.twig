{% extends 'base.html.twig' %}

{% block title %}
    Settings - General Account
{% endblock %}

{% block stylesheets %}
    <link href="{{ asset_url('css/settings.css') }}" rel="stylesheet">
{% endblock %}

{% block scripts %}
    <script src="{{ asset_url('js/settings-account-location.js') }}"></script>
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}

        <div style="text-align: center">
            {{ include('component/settings-nav.html.twig') }}

            <div style="padding-top: 1rem">
                <h5 class="text-center">Locations</h5>

                <div style="padding-bottom: .8rem">
                    <p>You can set the location where you have watched a movie.</p>

                    {% if locationsEnabled %}
                        <button type="button" class="btn btn-outline-danger" onclick="toggleLocationFeature()" id="toggleLocationsFeatureBtn">Disable locations</button>
                    {% else %}
                        <button type="button" class="btn btn-primary" onclick="toggleLocationFeature()" id="toggleLocationsFeatureBtn">Enable locations</button>
                    {% endif %}
                </div>

                <div id="locationToggleAlerts"></div>

                <hr>

                <div class="d-flex justify-content-between align-items-center gap-3 mb-3 text-start">
                    <div class="d-flex align-items-center gap-2">
                        <select class="form-select" id="locationsPerPage" style="width: 5rem" {% if locationsEnabled == false %}disabled{% endif %}>
                            <option value="20" {{ locationsPerPage == 20 ? 'selected' }}>20</option>
                            <option value="50" {{ locationsPerPage == 50 ? 'selected' }}>50</option>
                            <option value="100" {{ locationsPerPage == 100 ? 'selected' }}>100</option>
                            <option value="250" {{ locationsPerPage == 250 ? 'selected' }}>250</option>
                        </select>
                        <label for="locationsPerPage" class="form-label mb-0">per page</label>
                    </div>
                    <button class="btn btn-primary" type="button" onclick="refreshLocationsPage()" aria-label="Refresh locations" title="Refresh locations" {% if locationsEnabled == false %}disabled{% endif %}>
                        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover" id="locationsTable">
                        <thead>
                        <tr>
                            <th scope="col">Location</th>
                            <th scope="col">Cinema</th>
                            <th scope="col">Plays</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for location in locations %}
                            <tr data-id="{{ location.id }}" data-is-cinema="{{ location.isCinema ? 'true' : 'false' }}" style="cursor: pointer">
                                <td>{{ location.name }}</td>
                                <td>{{ location.isCinema ? 'Yes' : 'No' }}</td>
                                <td>{{ location.plays }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                {{ include('component/pagination.html.twig', {
                    paginationPath: applicationUrl ~ '/settings/account/locations',
                    paginationQuery: paginationQuery,
                }) }}

                <div id="locationAlerts"></div>

                <button type="button" class="btn btn-primary" style="width: 100%" onclick="showCreateLocationModal()" id="createLocationBtn" {% if locationsEnabled == false %}disabled{% endif %}>Add Location</button>
                <br>
            </div>
        </div>

        {{ include('component/modal-location.html.twig') }}
    </main>
{% endblock %}
