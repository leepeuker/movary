{% extends 'base.html.twig' %}

{% block title %}
    Settings - General Account
{% endblock %}

{% block stylesheets %}
    <link href="{{ asset_url('css/settings.css') }}" rel="stylesheet">
{% endblock %}

{% block scripts %}
    <script src="{{ asset_url('js/settings-account-general.js') }}"></script>
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}

        <div style="text-align: center;">
            {{ include('component/settings-nav.html.twig') }}

            <div style="padding-top: 1rem">
                <h5>General settings</h5>

                <div class="mb-3" id="accountEmailSettings"
                     data-current-email="{{ email }}">
                    <label for="emailInput" class="form-label"><b>Email</b> <span class="text-danger">*</span></label>
                    <input type="email"
                           class="form-control"
                           value="{{ pendingEmail|default(email) }}"
                           required
                           id="emailInput"
                           aria-describedby="accountEmailHelp"
                           {% if coreAccountChangesDisabled == true %}disabled{% endif %}
                           style="text-align: center;">
                    <div id="accountEmailHelp" class="form-text">
                        Current login email: <span id="currentEmailAddress">{{ email }}</span>
                    </div>
                    <div class="mt-2 {{ pendingEmail ? '' : 'd-none' }}" id="pendingEmailActions">
                        <div class="form-text text-warning" id="pendingEmailStatus">
                            {% if pendingEmail %}
                                {% if emailVerificationEnabled %}
                                    The current login email remains {{ email }} until {{ pendingEmail }} is verified.
                                {% else %}
                                    A previous email change to {{ pendingEmail }} is pending. Save it to apply it immediately, or cancel the change.
                                {% endif %}
                            {% endif %}
                        </div>
                        <div class="d-flex justify-content-center flex-wrap gap-2 mt-2">
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary {{ emailVerificationEnabled ? '' : 'd-none' }}"
                                    id="resendPendingEmailButton"
                                    {% if coreAccountChangesDisabled == true %}disabled{% endif %}>
                                Resend verification
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    id="cancelPendingEmailButton"
                                    {% if coreAccountChangesDisabled == true %}disabled{% endif %}>
                                Cancel change
                            </button>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="emailCurrentPasswordInput" class="form-label"><b>Current password</b> <span class="text-danger">*</span></label>
                    <input type="password"
                           class="form-control"
                           required
                           id="emailCurrentPasswordInput"
                           aria-describedby="emailCurrentPasswordHelp"
                           {% if coreAccountChangesDisabled == true %}disabled{% endif %}
                           style="text-align: center;">
                    <div id="emailCurrentPasswordHelp" class="form-text">Required to change your login email</div>
                </div>

                <div id="alertAccountEmailDiv"></div>

                <button type="button"
                        class="btn btn-primary"
                        id="accountEmailUpdateButton"
                        {% if coreAccountChangesDisabled == true %}disabled{% endif %}>
                    Update email
                </button>

                <hr>

                <div class="mb-3">
                    <label for="nameInput" class="form-label"><b>Username</b> <span class="text-danger">*</span></label>
                    <input type="text"
                           class="form-control"
                           placeholder="Username"
                           value="{{ username }}"
                           title="Only letters and numbers allowed"
                           required
                           id="nameInput"
                           aria-describedby="usernameHelp"
                           style="text-align: center;">
                    <div id="usernameHelp" class="form-text">Must consist of only letters and numbers</div>
                </div>

                <div class="mb-3">
                    <label for="dateFormatInput" class="form-label"><b>Date format</b></label>
                    <select class="form-select" style="text-align: center;padding-right:0;" required id="dateFormatInput" aria-describedby="emailHelp">
                        {% for dateFormatOffset, dateFormat in dateFormats %}
                            <option {% if dateFormatSelected == dateFormatOffset %}selected{% endif %} value="{{ dateFormatOffset }}">{{ dateFormat.javascript }}</option>
                        {% endfor %}
                    </select>
                    <div id="emailHelp" class="form-text">Format used when displaying dates</div>
                </div>

                <div class="mb-3">
                    <label for="privacyInput" class="form-label"><b>Privacy</b></label>
                    <select class="form-select" name="privacyLevel" style="text-align: center;padding-right:0;" id="privacyInput" aria-describedby="privacyHelp" required>
                        <option value="0" {% if privacyLevel == 0 %}selected{% endif %}>Not visible</option>
                        <option value="1" {% if privacyLevel == 1 %}selected{% endif %}>Visible to users</option>
                        <option value="2" {% if privacyLevel == 2 %}selected{% endif %}>Visible to everyone</option>
                    </select>
                    <div id="privacyHelp" class="form-text">Who can see your history and ratings</div>
                </div>

                <div class="mb-3">
                    <label for="movieTitleDisplayInput" class="form-label"><b>Movie titles</b></label>
                    <select class="form-select" style="text-align: center;padding-right:0;" required id="movieTitleDisplayInput" aria-describedby="movieTitleDisplayHelp">
                        <option value="localized" {% if movieTitleDisplay == 'localized' %}selected{% endif %}>Localized</option>
                        <option value="original" {% if movieTitleDisplay == 'original' %}selected{% endif %}>Original</option>
                        <option value="both" {% if movieTitleDisplay == 'both' %}selected{% endif %}>Localized and original</option>
                    </select>
                    <div id="movieTitleDisplayHelp" class="form-text">Choose how movie titles are displayed</div>
                </div>

                <div class="mb-3">
                    <label for="countryInput" class="form-label"><b>Country</b></label>
                    <select class="form-select" name="country" style="text-align: center;padding-right:0;" id="countryInput" aria-describedby="countryHelp" required>
                        <option value=""></option>
                        {% for ISO31661, name in countries %}
                            <option value="{{ ISO31661 }}" {% if ISO31661 == userCountry %}selected{% endif %}>{{ name }}</option>
                        {% endfor %}
                    </select>
                    <div id="privacyHelp" class="form-text">Used as default for "Where to Watch"</div>
                </div>

                <div style="padding-bottom: 1rem;padding-top: 0.5rem">
                    <input class="form-check-input"
                           type="checkbox"
                           value="1"
                           id="enableAutomaticWatchlistRemovalInput"
                           {% if enableAutomaticWatchlistRemoval == true %}checked{% endif %}
                           style="margin-right: 0.2rem">
                    <label class="form-check-label" for="scrobbleWatchesCheckbox">Enable automatic removals from watchlist</label>
                </div>

                <div style="padding-bottom: 1rem;">
                    <input class="form-check-input"
                           type="checkbox"
                           value="1"
                           id="displayCharacterNamesInput"
                           {% if displayCharacterNamesInput == true %}checked{% endif %}
                           style="margin-right: 0.2rem">
                    <label class="form-check-label" for="displayCharacterNamesInput">Display cast character names on movie pages</label>
                </div>

                <div style="padding-bottom: 1rem;">
                    <input class="form-check-input"
                           type="checkbox"
                           value="1"
                           id="displayTmdbRatingsInput"
                           {% if displayTmdbRatingsInput == true %}checked{% endif %}
                           style="margin-right: 0.2rem">
                    <label class="form-check-label" for="displayTmdbRatingsInput">Display TMDB ratings on movie pages</label>
                </div>

                <div style="padding-bottom: 1rem;">
                    <input class="form-check-input"
                           type="checkbox"
                           value="1"
                           id="displayImdbRatingsInput"
                           {% if displayImdbRatingsInput == true %}checked{% endif %}
                           style="margin-right: 0.2rem">
                    <label class="form-check-label" for="displayImdbRatingsInput">Display IMDb ratings on movie pages</label>
                </div>

                <div id="alertGeneralAccountDiv"></div>

                <button type="submit" class="btn btn-primary" id="generalAccountUpdateButton">Submit</button>
            </div>
        </div>
    </main>
{% endblock %}
