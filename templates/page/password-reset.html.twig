{% extends 'base.html.twig' %}

{% block title %}
    Reset password
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset_url('css/password-reset.css') }}">
{% endblock %}

{% block body %}
    <script>
        if ("{{ theme }}" === 'dark') document.getElementsByTagName('body')[0].classList.add('bg-dark')
    </script>
    <main role="main" class="form-password-reset w-100 m-auto text-center">
        <h1 class="text-{{ theme == 'dark' ? 'light' : 'dark' }}">Reset password</h1>
        {% if tokenValid == false %}
            <div class="alert alert-danger" role="alert">
                This password reset link is invalid or has expired.
            </div>
            <a href="{{ applicationUrl }}/forgot-password">Request a new reset link</a>
        {% else %}
            <form action="{{ applicationUrl }}/reset-password" method="post">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <input type="hidden" name="token" value="{{ token }}">
                <div class="form-floating mb-2">
                    <input type="password" name="password" class="form-control" id="passwordResetPassword"
                           placeholder="New password" minlength="8" autocomplete="new-password" required>
                    <label for="passwordResetPassword">New password</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="password" name="repeatPassword" class="form-control" id="passwordResetPasswordRepeat"
                           placeholder="Repeat new password" minlength="8" autocomplete="new-password" required>
                    <label for="passwordResetPasswordRepeat">Repeat new password</label>
                </div>
                {% if missingFormData == true %}
                    <div class="alert alert-danger" role="alert">Please fill out all fields.</div>
                {% endif %}
                {% if passwordsDoNotMatch == true %}
                    <div class="alert alert-danger" role="alert">Passwords do not match.</div>
                {% endif %}
                {% if minimumPasswordLength != null %}
                    <div class="alert alert-danger" role="alert">
                        Password must be at least {{ minimumPasswordLength }} characters.
                    </div>
                {% endif %}
                {% if genericError == true %}
                    <div class="alert alert-danger" role="alert">
                        The password could not be reset. Please try again.
                    </div>
                {% endif %}
                <button class="w-100 btn btn-primary mb-3" type="submit">Reset password</button>
            </form>
            <a href="{{ applicationUrl }}/login">Back to login</a>
        {% endif %}
    </main>
{% endblock %}
