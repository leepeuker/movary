{% extends 'base.html.twig' %}

{% block title %}
    {{ routeUsername }}'s watchlist
{% endblock %}

{% block scripts %}
    <script src="{{ applicationUrl }}/js/component/user-select.js"></script>
    <script src="{{ applicationUrl }}/js/component/modal-advanced-search-watchlist.html.js"></script>
    <script src="{{ applicationUrl }}/js/movie-list-view.js"></script>
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}

        <div style="text-align: center;">
            {{ include('component/user-select.html.twig') }}
            {{ include('component/modal-advanced-search-watchlist.html.twig') }}

            <div class="input-group mb-3">
                <input type="text" class="form-control" name="s" placeholder="Search watchlist" value="{{ (searchTerm is null) ? '' : searchTerm }}" style="border-right-color: #aab0b3" id="searchTermInput">
                <button class="btn btn-primary" type="button" onclick="search()" id="directSearchButton" aria-label="Search watchlist" title="Search watchlist">
                    <i class="bi bi-search" aria-hidden="true"></i>
                </button>
                <button id="toggleSearchOptionsButton" class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#searchOptionsMovieModal"
                        aria-label="Open search options" title="Open search options" style="border-left-color: #aab0b3">
                    <i class="bi bi-filter" aria-hidden="true"></i>
                </button>
                <button id="movieViewToggleButton" class="btn btn-primary" type="button" aria-label="Show table view" title="Show table view"
                        data-storage-key="movieListView" style="border-left-color: #aab0b3">
                    <svg id="movieTableViewIcon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm15 2H1v3h14zm0 4H1v3h14zm0 4H1v2a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1z"/>
                    </svg>
                    <svg id="moviePosterViewIcon" class="d-none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M1 1h6v6H1zm8 0h6v6H9zM1 9h6v6H1zm8 0h6v6H9z"/>
                    </svg>
                </button>
            </div>


            <div id="watchlistAlert" role="alert"></div>
            <div id="moviePosterView" class="row row-cols-3 row-cols-md-3 row-cols-lg-6">
                {% for watchlistEntry in watchlistEntries %}
                    <div class="col" style="padding-bottom: 1rem;">
                        <a
                            href="{{ applicationUrl }}/users/{{ routeUsername }}/movies/{{ watchlistEntry.id }}-{{ watchlistEntry.title|slugify }}"
                            class="card h-100"
                            style="cursor: pointer; position: relative;"
                            id="card-{{ watchlistEntry.id }}"
                        >
                            <img data-movieId="{{ watchlistEntry.id }}" src="{{ watchlistEntry.poster_path }}" class="card-img-top card-img-bottom object-fit-cover h-100" alt="{{ watchlistEntry.title }} Poster">
                       </a>
                    </div>
                {% endfor %}
            </div>

            <div id="movieTableView" class="table-responsive d-none">
                <table class="table table-hover align-middle text-start">
                    <thead>
                        <tr>
                            <th class="d-none d-sm-table-cell" scope="col">Poster</th>
                            <th scope="col">Title</th>
                            <th scope="col">Release</th>
                            <th scope="col">Runtime</th>
                            <th class="d-none d-md-table-cell" scope="col">User rating</th>
                            <th class="d-none d-lg-table-cell" scope="col">Last watched</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for watchlistEntry in watchlistEntries %}
                            {% set movieUrl = applicationUrl ~ '/users/' ~ routeUsername ~ '/movies/' ~ watchlistEntry.id ~ '-' ~ watchlistEntry.title|slugify %}
                            <tr>
                                <td class="d-none d-sm-table-cell">
                                    <a href="{{ movieUrl }}">
                                        <img src="{{ watchlistEntry.poster_path }}" class="rounded-1" width="46" alt="Poster for {{ watchlistEntry.title }}">
                                    </a>
                                </td>
                                <td><a href="{{ movieUrl }}">{{ watchlistEntry.title }}</a></td>
                                <td>{{ watchlistEntry.release_date is null ? '—' : watchlistEntry.release_date|date(dateFormatPhp) }}</td>
                                <td>{{ watchlistEntry.runtime is null ? '—' : watchlistEntry.runtime ~ ' min' }}</td>
                                <td class="d-none d-md-table-cell">{{ watchlistEntry.userRating is null ? '—' : watchlistEntry.userRating }}</td>
                                <td class="d-none d-lg-table-cell">{{ watchlistEntry.lastWatchedAt is null ? '—' : watchlistEntry.lastWatchedAt|date(dateFormatPhp) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% set searchTermQuery = (searchTerm is null) ? '' : "s=#{searchTerm}&" %}
            {% set sortByQuery = (sortBy is null) ? '' : "sb=#{sortBy}&" %}
            {% set sortOrderQuery = (sortOrder is null) ? '' : "so=#{sortOrder}&" %}
            {% set perPageQuery = (perPage is null) ? '' : "pp=#{perPage}&" %}
            {% set releaseYearQuery = (releaseYear is null) ? '' : "ry=#{releaseYear}&" %}
            {% set genreQuery = (genre is null) ? '' : "ge=#{genre}&" %}
            {% set languageQuery = (language is null) ? '' : "la=#{language}&" %}
            {% set productionCountryCode = (productionCountryCode is null) ? '' : "pc=#{productionCountryCode}&" %}
            {% set baseUrl = applicationUrl ~ '/users/' ~ routeUsername ~ '/watchlist?' ~ searchTermQuery ~ sortByQuery ~ sortOrderQuery ~ perPageQuery ~ releaseYearQuery ~ genreQuery ~ languageQuery ~ productionCountryCode %}

            <ul class="pagination justify-content-center">
                {% if paginationElements.previous is null %}
                    <li class="page-item disabled"><p class="page-link"><span aria-hidden="true">&laquo;</span></p></li>
                    <li class="page-item disabled"><p class="page-link"><span aria-hidden="true">&lsaquo;</span></p></li>
                {% else %}
                    <li class="page-item">
                        <a class="page-link" href="{{ baseUrl }}p=1">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="{{ baseUrl }}p={{ paginationElements.previous }}">
                            <span aria-hidden="true">&lsaquo;</span>
                        </a>
                    </li>
                {% endif %}
                <li class="page-item active">
                    <p class="page-link">{{ paginationElements.currentPage }} of {{ paginationElements.maxPage }}</p>
                </li>
                {% if paginationElements.next is null %}
                    <li class="page-item disabled"><p class="page-link"><span aria-hidden="true">&rsaquo;</span></p></li>
                    <li class="page-item disabled"><p class="page-link"><span aria-hidden="true">&raquo;</span></p></li>
                {% else %}
                    <li class="page-item">
                        <a class="page-link" href="{{ baseUrl }}p={{ paginationElements.next }}">
                            <span aria-hidden="true">&rsaquo;</span>
                        </a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="{{ baseUrl }}p={{ paginationElements.maxPage }}">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </main>
{% endblock %}
