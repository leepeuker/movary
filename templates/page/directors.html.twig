{% extends 'base.html.twig' %}

{% block title %}
    {{ routeUsername }}'s most watched directors
{% endblock %}

{% block scripts %}
    <script src="{{ asset_url('js/component/user-select.js') }}"></script>
    <script src="{{ asset_url('js/component/modal-advanced-search-person.html.js') }}"></script>
    <script src="{{ asset_url('js/movie-list-view.js') }}"></script>
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}

        <div style="text-align: center;">
            {{ include('component/user-select.html.twig') }}
            {{ include('component/modal-advanced-search-person.html.twig') }}

            <div class="input-group mb-3">
                <input type="text" class="form-control" name="s" placeholder="Search directors" value="{{ (searchTerm is null) ? '' : searchTerm }}" style="border-right-color: #aab0b3" id="searchTermInput">
                <button class="btn btn-primary" type="button" onclick="search()" id="directSearchButton" aria-label="Search directors" title="Search directors">
                    <i class="bi bi-search" aria-hidden="true"></i>
                </button>
                <button id="toggleSearchOptionsButton" class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#searchOptionsPersonModal"
                        aria-label="Open search options" title="Open search options" style="border-left-color: #aab0b3">
                    <i class="bi bi-filter" aria-hidden="true"></i>
                </button>
                <button id="movieViewToggleButton" class="btn btn-primary" type="button" aria-label="Show table view" title="Show table view"
                        data-storage-key="movieListView" style="border-left-color: #aab0b3">
                    <i id="movieTableViewIcon" class="bi bi-table" aria-hidden="true"></i>
                    <i id="moviePosterViewIcon" class="bi bi-grid-fill d-none" aria-hidden="true"></i>
                </button>
            </div>

            <div id="moviePosterView" class="poster-grid row row-cols-3 row-cols-md-3 row-cols-lg-5 row-cols-xxl-6">
                {% for mostWatchedDirector in mostWatchedDirectors %}
                    <div class="col">
                        <div class="card h-100 position-relative">
                            <div class="card-header text-truncate" style="padding: 0.2rem">
                                <small class="text-muted" style="font-siz1e: 0.9rem;">{{ mostWatchedDirector.name }}</small>
                            </div>
                            <input id="directorName_{{ mostWatchedDirector.id }}" value="{{ mostWatchedDirector.name }}" type="hidden">
                            <a class="poster-link d-block {% if sortBy != 'uniqueAppearances' and sortBy != 'totalAppearances' %}card-img-bottom{% endif %}"
                               href="{{ applicationUrl }}/users/{{ routeUsername }}/persons/{{ mostWatchedDirector.id }}-{{ mostWatchedDirector.name|slugify }}">
                                <img class="{% if sortBy != 'uniqueAppearances' and sortBy != 'totalAppearances' %}card-img-bottom{% endif %}"
                                     style="max-width: 100%" src="{{ mostWatchedDirector.poster_path }}" alt="{{ mostWatchedDirector.name }} Poster">
                            </a>
                            {% if sortBy == 'uniqueAppearances' or sortBy == 'totalAppearances' %}
                                <div class="poster-footer card-footer">
                                    <small class="text-muted" style="font-size: 0.8rem">
                                        {% if sortBy == 'uniqueAppearances' %} {{ mostWatchedDirector.uniqueCount }} {% else %} {{ mostWatchedDirector.totalCount }} {% endif %}
                                    </small>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div id="movieTableView" class="table-responsive d-none">
                <table class="table table-hover align-middle text-start" data-sort-by="{{ sortBy }}" data-sort-order="{{ sortOrder }}">
                    <thead>
                        <tr>
                            <th class="d-none d-sm-table-cell" scope="col">Poster</th>
                            <th scope="col"><button class="btn btn-link p-0 text-reset text-decoration-none fw-semibold" type="button" data-sort-by="name">Name</button></th>
                            <th scope="col">Gender</th>
                            <th class="d-none d-lg-table-cell" scope="col"><button class="btn btn-link p-0 text-reset text-decoration-none fw-semibold" type="button" data-sort-by="birthDate">Birthday</button></th>
                            <th scope="col"><button class="btn btn-link p-0 text-reset text-decoration-none fw-semibold" type="button" data-sort-by="uniqueAppearances">Unique appearances</button></th>
                            <th scope="col"><button class="btn btn-link p-0 text-reset text-decoration-none fw-semibold" type="button" data-sort-by="totalAppearances">Total appearances</button></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for mostWatchedDirector in mostWatchedDirectors %}
                            {% set personUrl = applicationUrl ~ '/users/' ~ routeUsername ~ '/persons/' ~ mostWatchedDirector.id ~ '-' ~ mostWatchedDirector.name|slugify %}
                            <tr>
                                <td class="d-none d-sm-table-cell">
                                    <a href="{{ personUrl }}">
                                        <img src="{{ mostWatchedDirector.poster_path }}" class="rounded-1" width="46" alt="Poster for {{ mostWatchedDirector.name }}">
                                    </a>
                                </td>
                                <td><a href="{{ personUrl }}">{{ mostWatchedDirector.name }}</a></td>
                                <td>{{ mostWatchedDirector.gender }}</td>
                                <td class="d-none d-lg-table-cell">{{ mostWatchedDirector.birth_date is null ? '—' : mostWatchedDirector.birth_date|date(dateFormatPhp) }}</td>
                                <td>{{ mostWatchedDirector.uniqueCount }}</td>
                                <td>{{ mostWatchedDirector.totalCount }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>


            {% set searchTermQuery = (searchTerm is null) ? '' : "s=#{searchTerm}&" %}
            {% set sortByQuery = (sortBy is null) ? '' : "sb=#{sortBy}&" %}
            {% set sortOrderQuery = (sortOrder is null) ? '' : "so=#{sortOrder}&" %}
            {% set perPageQuery = (perPage is null) ? '' : "pp=#{perPage}&" %}
            {% set genderQuery = (filterGender is null) ? '' : "ge=#{filterGender}&" %}
            {% set baseUrl = applicationUrl ~ '/users/' ~ routeUsername ~ '/directors?' ~ searchTermQuery ~ sortByQuery ~ sortOrderQuery ~ perPageQuery ~ releaseYearQuery ~ genderQuery ~ languageQuery %}

            <ul class="pagination justify-content-center mt-3">
                {% if paginationElements.previous is null %}
                    <li class="page-item disabled"><p class="page-link"><span aria-hidden="true">&laquo;</span></p></li>
                    <li class="page-item disabled"><p class="page-link"><span aria-hidden="true">&lsaquo;</span></p></li>
                {% else %}
                    <li class="page-item">
                        <a class="page-link" href="{{ baseUrl }}p=1">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                    <li class="page-item">
                        <a class="page-link"
                           href="{{ baseUrl }}p={{ paginationElements.previous }}">
                            <span aria-hidden="true">&lsaquo;</span>
                        </a>
                    </li>
                {% endif %}
                <li class="page-item active">
                    <p class="page-link">{{ paginationElements.currentPage }} of {{ paginationElements.maxPage }}</p>
                </li>
                {% if paginationElements.next is null %}
                    <li class="page-item disabled"><p class="page-link"><span aria-hidden="true">&rsaquo;</span></p></li>
                    <li class="page-item disabled"><p class="page-link"><span aria-hidden="true">&raquo;</span></p></li>
                {% else %}
                    <li class="page-item">
                        <a class="page-link" href="{{ baseUrl }}p={{ paginationElements.next }}">
                            <span aria-hidden="true">&rsaquo;</span>
                        </a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="{{ baseUrl }}p={{ paginationElements.maxPage }}">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                {% endif %}
            </ul>

        </div>
    </main>
{% endblock %}
