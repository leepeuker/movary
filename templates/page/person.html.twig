{% extends 'base.html.twig' %}

{% block title -%}
    {{ person.name }}
{%- endblock %}

{% block ogImage -%}
    {{ person.posterPath }}
{%- endblock %}

{% block scripts -%}
    <script src="{{ js_url('component/user-select.js') }}"></script>
    <script src="{{ js_url('person.js') }}"></script>
{% endblock %}

{% block stylesheets %}
    <link href="{{ css_url('person.css') }}" rel="stylesheet">
{% endblock %}

{% macro movieGrid(movies, applicationUrl, routeUsername) %}
    <div class="poster-grid row row-cols-3 row-cols-md-3 row-cols-lg-5 row-cols-xxl-6 text-center">
        {% for movie in movies %}
            <div class="col position-relative">
                <a class="poster-link card h-100 position-relative" href="{{ applicationUrl }}/users/{{ routeUsername }}/movies/{{ movie.id }}-{{ movie.title|slugify }}">
                    <div class="position-relative">
                        <img src="{{ movie.poster_path }}" class="card-img-top card-img-bottom" alt="{{ movie.title|movie_title(movie.original_title) }} Poster" loading="lazy">
                    </div>
                    {% if movie.userRating is not null %}
                        <span class="poster-rating position-absolute badge rounded-pill bg-warning text-dark">{{ movie.userRating }}</span>
                    {% endif %}
                </a>
            </div>
        {% endfor %}
    </div>
{% endmacro %}

{% block body %}
    {% set watchedMovies = {} %}
    {% for movie in moviesAsActor|merge(moviesAsDirector) %}
        {% set watchedMovies = watchedMovies|merge({('movie-' ~ movie.id): movie}) %}
    {% endfor %}
    {% set watchedMovies = watchedMovies|sort((a, b) => a.title|lower <=> b.title|lower) %}

    <main role="main" class="container person-page">
        {{ include('component/navbar.html.twig') }}
        {{ include('component/user-select.html.twig') }}

        <input type="hidden" id="personId" value="{{ person.id }}">

        <div class="person-profile">
            <header class="person-heading">
                <h1 id="personName" class="h2 mb-0">{{ person.name }}</h1>
                {% if currentUserName is not null %}
                    <button type="button" id="moreSpecificMovieButton" class="btn btn-sm btn-outline-secondary person-options-button"
                            data-bs-toggle="modal" data-bs-target="#moreModal"
                            aria-label="Person options" title="Person options">
                        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                    </button>
                {% endif %}
            </header>
            <aside class="person-sidebar" aria-label="Personal information">
                <img src="{{ person.posterPath }}" class="person-portrait rounded-2" alt="{{ person.name }}">
                <div class="person-links">
                    <a href="{{ person.tmdbUrl }}" target="_blank" rel="noopener noreferrer" class="person-external-link">
                        <img src="{{ applicationUrl }}/images/tmdb-logo.svg" class="person-logo-tmdb" alt="TMDB">
                    </a>
                    {% if person.imdbUrl is not null %}
                        <a href="{{ person.imdbUrl }}" target="_blank" rel="noopener noreferrer" class="person-external-link">
                            <img src="{{ applicationUrl }}/images/imdb-logo.svg" class="person-logo-imdb" alt="IMDb">
                        </a>
                    {% endif %}
                </div>
                <div class="person-info">
                    <dl class="person-facts">
                        {% if person.knownForDepartment is not empty %}
                            <div>
                                <dt>Department</dt>
                                <dd>{{ person.knownForDepartment }}</dd>
                            </div>
                        {% endif %}
                        {% if person.birthDate is not null %}
                            <div>
                                <dt>Born</dt>
                                <dd>{{ person.birthDate }}{% if person.deathDate is null and person.age is not null %} ({{ person.age }}){% endif %}</dd>
                            </div>
                        {% endif %}
                        {% if person.deathDate is not null %}
                            <div>
                                <dt>Died</dt>
                                <dd>{{ person.deathDate }}{% if person.age is not null %} (aged {{ person.age }}){% endif %}</dd>
                            </div>
                        {% endif %}
                        {% if person.placeOfBirth is not empty %}
                            <div>
                                <dt>Place of birth</dt>
                                <dd>{{ person.placeOfBirth }}</dd>
                            </div>
                        {% endif %}
                        {% if person.gender != '0' %}
                            <div>
                                <dt>Gender</dt>
                                <dd>{{ person.gender == '1' ? 'Female' }}{{ person.gender == '2' ? 'Male' }}{{ person.gender == '3' ? 'Non-Binary' }}</dd>
                            </div>
                        {% endif %}
                    </dl>
                </div>
            </aside>
            <div class="person-content">
                <section class="person-biography" aria-labelledby="biographyHeading">
                    <h2 id="biographyHeading" class="h6 fw-bold">Biography</h2>
                    {% set biography = person.biography|default('') %}
                    {% if biography|trim is not empty %}
                        <p id="biographyParagraph" class="person-biography-text">{{ biography|nl2br }}</p>
                        <button type="button" id="biographyToggle" class="btn btn-sm btn-outline-secondary mt-2 d-none" aria-controls="biographyParagraph" aria-expanded="false">Read more</button>
                    {% else %}
                        <p class="text-body-secondary mb-0">No biography available.</p>
                    {% endif %}
                </section>
                <section class="person-movies" aria-labelledby="personMoviesHeading">
                    <h2 id="personMoviesHeading" class="h6 fw-bold mb-2">Watched <span class="text-body-secondary">({{ watchedMovies|length }})</span></h2>
                    {% if watchedMovies is not empty %}
                        {{ _self.movieGrid(watchedMovies, applicationUrl, routeUsername) }}
                    {% else %}
                        <p class="text-body-secondary mb-0">No watched movies for this person yet.</p>
                    {% endif %}
                </section>
            </div>
        </div>

        {% if currentUserName is not null %}
            {{ include('component/modal-person-more-options.html.twig') }}
            {% if currentUserIsAdmin == true %}
                {{ include('component/modal-change-person-profile.html.twig') }}
            {% endif %}
        {% endif %}
    </main>
{% endblock %}
