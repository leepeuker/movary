{% extends 'base.html.twig' %}

{% block title -%}
    {{ person.name }}
{%- endblock %}

{% block ogImage -%}
    {{ person.posterPath }}
{%- endblock %}

{% block scripts -%}
    <script src="{{ js_url('component/user-select.js') }}"></script>
    <script src="{{ js_url('person.js') }}"></script>
{% endblock %}

{% block stylesheets %}
    <link href="{{ css_url('person.css') }}" rel="stylesheet">
{% endblock %}

{% macro movieGrid(movies, applicationUrl, routeUsername, label) %}
    <div class="person-movie-carousel position-relative">
        <div class="person-movie-grid" tabindex="0" role="group" aria-label="{{ label }}">
            {% for movie in movies %}
                <div class="position-relative" {{ _self.movieSortData(movie) }}>
                    <a class="poster-link card h-100 position-relative" href="{{ applicationUrl }}/users/{{ routeUsername }}/movies/{{ movie.id }}-{{ movie.title|slugify }}">
                        <div class="position-relative">
                            <img src="{{ movie.poster_path }}" class="card-img-top card-img-bottom" alt="{{ movie.title|movie_title(movie.original_title) }} Poster" loading="lazy">
                        </div>
                        {% if movie.userRating is not null %}
                            <span class="poster-rating position-absolute badge rounded-pill bg-warning text-dark">{{ movie.userRating }}</span>
                        {% endif %}
                    </a>
                </div>
            {% endfor %}
        </div>
        <button type="button" class="btn rounded-circle person-movie-scroll person-movie-scroll-previous d-none"
                data-direction="-1" aria-label="Scroll {{ label|lower }} left">
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
        </button>
        <button type="button" class="btn rounded-circle person-movie-scroll person-movie-scroll-next d-none"
                data-direction="1" aria-label="Scroll {{ label|lower }} right">
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
        </button>
    </div>
{% endmacro %}

{% macro movieTable(movies, applicationUrl, routeUsername, dateFormatPhp) %}
    <div class="person-movie-table table-responsive d-none">
        <table class="table table-hover align-middle text-start">
            <thead>
                <tr>
                    <th class="d-none d-sm-table-cell" scope="col">Poster</th>
                    <th scope="col">{{ _self.sortHeading('title', 'Title') }}</th>
                    <th scope="col">{{ _self.sortHeading('releaseDate', 'Release') }}</th>
                    <th class="d-none d-md-table-cell" scope="col">{{ _self.sortHeading('rating', 'User rating') }}</th>
                    <th scope="col">{{ _self.sortHeading('watchDate', 'Last watched') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for movie in movies %}
                    {% set movieUrl = applicationUrl ~ '/users/' ~ routeUsername ~ '/movies/' ~ movie.id ~ '-' ~ movie.title|slugify %}
                    <tr {{ _self.movieSortData(movie) }}>
                        <td class="d-none d-sm-table-cell">
                            <a href="{{ movieUrl }}">
                                <img src="{{ movie.poster_path }}" class="rounded-1" width="46" alt="Poster for {{ movie.title|movie_title(movie.original_title) }}" loading="lazy">
                            </a>
                        </td>
                        <td><a href="{{ movieUrl }}">{{ movie.title|movie_title(movie.original_title) }}</a></td>
                        <td>{{ movie.release_date is null ? '—' : movie.release_date|date('Y') }}</td>
                        <td class="d-none d-md-table-cell">{{ movie.userRating is null ? '—' : movie.userRating }}</td>
                        <td>{{ movie.lastWatchedAt|default(null) is null ? '—' : movie.lastWatchedAt|date(dateFormatPhp) }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endmacro %}

{% macro movieSortData(movie) %}
    data-movie-id="{{ movie.id }}" data-title="{{ movie.title }}" data-release-date="{{ movie.release_date }}" data-watch-date="{{ movie.lastWatchedAt|default('') }}" data-rating="{{ movie.userRating }}"
{% endmacro %}

{% macro sortHeading(key, label) %}
    <button class="btn btn-link p-0 text-reset text-decoration-none fw-semibold" type="button" data-sort-by="{{ key }}">{{ label }}<span class="person-sort-indicator fs-5" aria-hidden="true"></span></button>
{% endmacro %}

{% macro sortControls(label, theme) %}
    <div class="dropdown">
        <button class="btn btn-sm {{ theme == 'dark' ? 'btn-outline-light' : 'btn-outline-dark' }} person-options-button" type="button"
                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Sort {{ label }}" title="Sort {{ label }}">
            <i class="bi bi-sort-down" aria-hidden="true"></i>
        </button>
        <div class="dropdown-menu dropdown-menu-end p-3 person-movie-sort-menu">
            <label class="input-group mb-3">
                <span class="input-group-text">Sort by</span>
                <select class="form-control person-movie-sort-by" aria-label="Sort {{ label }} by">
                    <option value="title">Title</option>
                    <option value="releaseDate" selected>Release date</option>
                    <option value="watchDate">Last watched</option>
                    <option value="rating">User rating</option>
                </select>
            </label>
            <label class="input-group">
                <span class="input-group-text">Sort order</span>
                <select class="form-control person-movie-sort-order" aria-label="Sort order for {{ label }}">
                    <option value="asc">Ascending</option>
                    <option value="desc" selected>Descending</option>
                </select>
            </label>
        </div>
    </div>
{% endmacro %}

{% block body %}
    <main role="main" class="container person-page">
        {{ include('component/navbar.html.twig') }}
        {{ include('component/user-select.html.twig') }}

        <input type="hidden" id="personId" value="{{ person.id }}">

        <div class="person-profile">
            <header class="person-heading">
                <h1 id="personName" class="h2 mb-0">{{ person.name }}</h1>
                {% if currentUserName is not null %}
                    <button type="button" id="moreSpecificMovieButton" class="btn btn-sm {{ theme == 'dark' ? 'btn-outline-light' : 'btn-outline-dark' }} person-options-button"
                            data-bs-toggle="modal" data-bs-target="#moreModal"
                            aria-label="Person options" title="Person options">
                        <i class="bi bi-gear" aria-hidden="true"></i>
                    </button>
                {% endif %}
            </header>
            <aside class="person-sidebar" aria-label="Personal information">
                <img src="{{ person.posterPath }}" class="person-portrait rounded-2" alt="{{ person.name }}">
                <div class="person-links">
                    <a href="{{ person.tmdbUrl }}" target="_blank" rel="noopener noreferrer" class="person-external-link" aria-label="TMDB" data-bs-toggle="tooltip" data-bs-title="TMDB">
                        <img src="{{ applicationUrl }}/images/tmdb-logo.svg" class="person-logo-tmdb" alt="TMDB">
                    </a>
                    {% if person.imdbUrl is not null %}
                        <a href="{{ person.imdbUrl }}" target="_blank" rel="noopener noreferrer" class="person-external-link" aria-label="IMDb" data-bs-toggle="tooltip" data-bs-title="IMDb">
                            <img src="{{ applicationUrl }}/images/imdb-logo.svg" class="person-logo-imdb" alt="IMDb">
                        </a>
                    {% endif %}
                    {% for link in person.externalLinks %}
                        <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer" class="person-external-link" aria-label="{{ link.name }}" data-bs-toggle="tooltip" data-bs-title="{{ link.name }}">
                            <img src="{{ applicationUrl }}/images/person-{{ link.icon }}" class="person-logo-social person-logo-{{ link.icon|split('.')|first }}" alt="">
                        </a>
                    {% endfor %}
                </div>
                <div class="person-info">
                    <dl class="person-facts">
                        {% if person.knownForDepartment is not empty %}
                            <div>
                                <dt>Known for</dt>
                                <dd>{{ person.knownForDepartment }}</dd>
                            </div>
                        {% endif %}
                        {% if person.birthDate is not null %}
                            <div>
                                <dt>Born</dt>
                                <dd>{{ person.birthDate }}{% if person.deathDate is null and person.age is not null %} ({{ person.age }}){% endif %}</dd>
                            </div>
                        {% endif %}
                        {% if person.deathDate is not null %}
                            <div>
                                <dt>Died</dt>
                                <dd>{{ person.deathDate }}{% if person.age is not null %} (aged {{ person.age }}){% endif %}</dd>
                            </div>
                        {% endif %}
                        {% if person.placeOfBirth is not empty %}
                            <div>
                                <dt>Place of birth</dt>
                                <dd>{{ person.placeOfBirth }}</dd>
                            </div>
                        {% endif %}
                        {% if person.gender != '0' %}
                            <div>
                                <dt>Gender</dt>
                                <dd>{{ person.gender == '1' ? 'Female' }}{{ person.gender == '2' ? 'Male' }}{{ person.gender == '3' ? 'Non-Binary' }}</dd>
                            </div>
                        {% endif %}
                    </dl>
                </div>
            </aside>
            <div class="person-content">
                <section class="person-biography" aria-labelledby="biographyHeading">
                    <h2 id="biographyHeading" class="h6 fw-bold">Biography</h2>
                    {% set biography = person.biography|default('') %}
                    {% if biography|trim is not empty %}
                        <p id="biographyParagraph" class="person-biography-text">{{ biography|nl2br }}</p>
                        <button type="button" id="biographyToggle" class="btn btn-sm btn-outline-secondary mt-2 d-none" aria-controls="biographyParagraph" aria-expanded="false">Read more</button>
                    {% else %}
                        <p class="text-body-secondary mb-0">No biography available.</p>
                    {% endif %}
                </section>
                <section class="person-movies person-movie-section{% if watchedMovies is not empty and watchlistMovies is empty %} person-movies-before-empty-watchlist{% endif %}" aria-labelledby="personMoviesHeading">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h2 id="personMoviesHeading" class="h6 fw-bold mb-0">Watched <span class="text-body-secondary">({{ watchedMovies|length }})</span></h2>
                        {% if watchedMovies is not empty %}
                            <div class="d-flex gap-2">
                                {{ _self.sortControls('watched movies', theme) }}
                                <button class="btn btn-sm {{ theme == 'dark' ? 'btn-outline-light' : 'btn-outline-dark' }} person-options-button person-movie-view-toggle" type="button" aria-label="Show table view for watched movies" title="Show table view for watched movies" data-storage-key="personWatchedView" data-view-label="watched movies">
                                    <i class="bi bi-table" aria-hidden="true"></i>
                                    <i class="bi bi-grid-fill d-none" aria-hidden="true"></i>
                                </button>
                            </div>
                        {% endif %}
                    </div>
                    {% if watchedMovies is not empty %}
                        {{ _self.movieGrid(watchedMovies, applicationUrl, routeUsername, 'Watched movies') }}
                        {{ _self.movieTable(watchedMovies, applicationUrl, routeUsername, dateFormatPhp|default('Y-m-d')) }}
                    {% else %}
                        <p class="text-body-secondary mb-0">No watched movies for this person yet.</p>
                    {% endif %}
                </section>
                <section class="person-watchlist person-movie-section" aria-labelledby="personWatchlistHeading">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h2 id="personWatchlistHeading" class="h6 fw-bold mb-0">On Watchlist <span class="text-body-secondary">({{ watchlistMovies|length }})</span></h2>
                        {% if watchlistMovies is not empty %}
                            <div class="d-flex gap-2">
                                {{ _self.sortControls('watchlist movies', theme) }}
                                <button class="btn btn-sm {{ theme == 'dark' ? 'btn-outline-light' : 'btn-outline-dark' }} person-options-button person-movie-view-toggle" type="button" aria-label="Show table view for watchlist movies" title="Show table view for watchlist movies" data-storage-key="personWatchlistView" data-view-label="watchlist movies">
                                    <i class="bi bi-table" aria-hidden="true"></i>
                                    <i class="bi bi-grid-fill d-none" aria-hidden="true"></i>
                                </button>
                            </div>
                        {% endif %}
                    </div>
                    {% if watchlistMovies is not empty %}
                        {{ _self.movieGrid(watchlistMovies, applicationUrl, routeUsername, 'Watchlist movies') }}
                        {{ _self.movieTable(watchlistMovies, applicationUrl, routeUsername, dateFormatPhp|default('Y-m-d')) }}
                    {% else %}
                        <p class="text-body-secondary mb-0">No watchlist movies for this person yet.</p>
                    {% endif %}
                </section>
            </div>
        </div>

        {% if currentUserName is not null %}
            {{ include('component/modal-person-more-options.html.twig') }}
            {% if currentUserIsAdmin == true %}
                {{ include('component/modal-change-person-profile.html.twig') }}
            {% endif %}
        {% endif %}
    </main>
{% endblock %}
