{% extends 'base.html.twig' %}

{% block title %}
    Settings - App
{% endblock %}

{% block stylesheets %}
    <link href="{{ applicationUrl }}/css/settings.css" rel="stylesheet">
{% endblock %}

{% block scripts %}
    <script src="{{ applicationUrl }}/js/settings-server-users.js"></script>
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}

        <div style="text-align: center;">
            {{ include('component/settings-nav.html.twig') }}

            <div style="padding-bottom: 1rem;padding-top: 1rem">
                <h5 style="margin-bottom: 1rem;">User Management</h5>

                <p class="text-muted">List of all users. Click on table row to edit/delete users.</p>

                <div id="userManagementAlerts"></div>

                <div class="table-responsive">
                    <table class="table table-hover" id="usersTable">
                        <thead>
                        <tr>
                            <th scope="col">Id</th>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Admin</th>
                        </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="spinner-border d-none" role="status" id="userTableLoadingSpinner">
                    <span class="visually-hidden">Loading...</span>
                </div>

                <button type="button" class="btn btn-primary float-end" style="width: 100%;" onclick="showCreateUserModal()">Create User</button>
            </div>

            <hr style="margin-top: 3rem">

            <div style="padding-bottom: 1rem;padding-top: 1rem">
                <h5 style="margin-bottom: 1rem;">Password Resets</h5>

                <p class="text-muted">Active password reset requests. Reset links and token hashes are never displayed.</p>

                <div id="passwordResetManagementAlerts"></div>

                <div class="table-responsive">
                    <table class="table" id="passwordResetsTable">
                        <thead>
                        <tr>
                            <th scope="col">User</th>
                            <th scope="col">Email</th>
                            <th scope="col">Created</th>
                            <th scope="col">Expires</th>
                            <th scope="col">Action</th>
                        </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="spinner-border d-none" role="status" id="passwordResetTableLoadingSpinner">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>

        {{ include('component/modal-user.html.twig') }}
    </main>
{% endblock %}
