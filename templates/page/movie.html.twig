{% extends 'base.html.twig' %}

{% block title -%}
    {{ movie.title|movie_title(movie.originalTitle) }} ({{ movie.releaseDate|date("Y") }})
{%- endblock %}

{% block ogImage -%}
    {{ movie.posterPath }}
{%- endblock %}

{% block stylesheets %}
    <link href="{{ css_url('movie.css') }}" rel="stylesheet">
{% endblock %}

{% block scripts %}
    <script src="{{ js_url('movie.js') }}"></script>
    <script src="{{ js_url('component/user-select.js') }}"></script>
{% endblock %}

{% macro credits(people, applicationUrl, routeUsername, characters, label) %}
    {% if people is not empty %}
        <div class="movie-credit-carousel position-relative">
            <div class="movie-credit-grid" tabindex="0" role="group" aria-label="{{ label }}">
                {% for person in people %}
                    <a class="movie-credit poster-link" href="{{ applicationUrl }}/users/{{ routeUsername }}/persons/{{ person.id }}-{{ person.name|slugify }}">
                        <img src="{{ person.posterPath }}" class="rounded-2" alt="{{ person.name }}" loading="lazy">
                        <span class="movie-credit-name">{{ person.name }}</span>
                        {% if characters %}
                            <span class="movie-credit-character text-body-secondary">{{ person.characterName }}</span>
                        {% endif %}
                    </a>
                {% endfor %}
            </div>
            <button type="button" class="btn rounded-circle movie-credit-scroll movie-credit-scroll-previous d-none" data-direction="-1" aria-label="Scroll {{ label|lower }} left">
                <i class="bi bi-chevron-left" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn rounded-circle movie-credit-scroll movie-credit-scroll-next d-none" data-direction="1" aria-label="Scroll {{ label|lower }} right">
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </button>
        </div>
    {% else %}
        <p class="text-body-secondary">No {{ label|lower }} available.</p>
    {% endif %}
{% endmacro %}

{% block body %}
    <main role="main" class="container movie-page">
        {{ include('component/navbar.html.twig') }}
        {{ include('component/user-select.html.twig') }}

        <input type="hidden" id="movieId" value="{{ movie.id }}">
        <input type="hidden" id="username" value="{{ routeUsername }}">

        {% set primaryTitle = movieTitleDisplay == 'original' and movie.originalTitle is not empty
            ? movie.originalTitle
            : (movie.title is not empty ? movie.title : movie.originalTitle) %}
        {% set hasBackdrop = movie.backdropPath is not empty %}
        {% if hasBackdrop %}
            <div class="movie-backdrop" aria-hidden="true">
                <img src="{{ movie.backdropPath }}" alt="" fetchpriority="high">
            </div>
        {% endif %}
        <div class="movie-profile{{ hasBackdrop ? ' movie-profile-with-backdrop' }}">
            <header class="movie-heading">
                <div>
                    <h1 class="h2 mb-1">{{ primaryTitle }} {% if movie.releaseDate is not null %}<span class="text-body-secondary">({{ movie.releaseDate|date('Y') }})</span>{% endif %}</h1>
                    {% if movieTitleDisplay == 'both' and movie.originalTitle is not empty and movie.originalTitle != primaryTitle %}
                        <div class="fs-5 text-body-secondary mb-1">{{ movie.originalTitle }}</div>
                    {% endif %}
                    <p class="movie-summary text-body-secondary mb-0">
                        {% for genre in movieGenres %}{{ genre.name }}{% if not loop.last %}, {% endif %}{% endfor %}
                        {% if movie.runtime is not empty %}{{ movieGenres is not empty ? ' · ' }}{{ movie.runtime }}{% endif %}
                        {% if movie.originalLanguage is not empty %}{{ movieGenres is not empty or movie.runtime is not empty ? ' · ' }}{{ movie.originalLanguage }}{% endif %}
                    </p>
                </div>
                {% if currentUserName == routeUsername %}
                    <button type="button" id="moreSpecificMovieButton" class="btn btn-sm {{ theme == 'dark' ? 'btn-outline-light' : 'btn-outline-dark' }} movie-options-button"
                            data-bs-toggle="modal" data-bs-target="#moreModal" aria-label="Movie options" title="Movie options">
                        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                    </button>
                {% endif %}
            </header>
            <aside class="movie-sidebar" aria-label="Movie information">
                <img src="{{ movie.posterPath }}" class="movie-poster rounded-2" alt="{{ primaryTitle }} Poster">
                <div class="movie-information">
                    <div class="movie-links">
                        {% if isOnWatchlist %}
                            <a id="bookmarkIcon" class="bi bi-bookmark-fill" href="{{ applicationUrl }}/users/{{ routeUsername }}/watchlist" aria-label="On Watchlist" data-bs-toggle="tooltip" data-bs-title="On Watchlist"></a>
                        {% endif %}
                        <div class="movie-external-rating">
                            <a href="{{ movie.tmdbUrl }}" target="_blank" rel="noopener noreferrer">
                                <img src="{{ applicationUrl }}/images/tmdb-logo.svg" class="movie-logo" alt="TMDB">
                            </a>
                            {% if displayTmdbRating and movie.tmdbRatingAverage is not empty and movie.tmdbRatingAverage != 0.0 %}
                                {# Must be in one line otherwise there is a whitespace between the slash and the vote count which looks ugly #}
                                <span><span class="fw-bold">{{ movie.tmdbRatingAverage|number_format(1, '.', ',') }}</span><span class="fw-light">/{{ movie.tmdbRatingVoteCount|default('-') }}</span></span>
                            {% endif %}
                        </div>
                        {% if movie.imdbId is not null %}
                            <div class="movie-external-rating">
                                <a href="{{ movie.imdbUrl }}" target="_blank" rel="noopener noreferrer">
                                    <img src="{{ applicationUrl }}/images/imdb-logo.svg" class="movie-logo" alt="IMDb">
                                </a>
                                {% if displayImdbRating and movie.imdbRatingAverage is not empty %}
                                    {# Must be in one line otherwise there is a whitespace between the slash and the vote count which looks ugly #}
                                    <span><span class="fw-bold">{{ movie.imdbRatingAverage|number_format(1, '.', ',') }}</span><span class="fw-light">/{{ movie.imdbRatingVoteCount|default('-') }}</span></span>
                                {% endif %}
                            </div>
                        {% endif %}
                        <a href="https://letterboxd.com/tmdb/{{ movie.tmdbId }}" target="_blank" rel="noopener noreferrer">
                            <img src="{{ applicationUrl }}/images/letterboxd-logo.png" class="movie-logo" alt="Letterboxd">
                        </a>
                    </div>
                <dl class="movie-facts">
                    {% if movie.releaseDate is not null %}
                        <div><dt>Release</dt><dd>{{ movie.releaseDate|date(dateFormatPhp) }}</dd></div>
                    {% endif %}
                    {% if movie.originalLanguage is not empty %}
                        <div><dt>Language</dt><dd>{{ movie.originalLanguage }}</dd></div>
                    {% endif %}
                    {% if movieProductionCountries is not empty %}
                        <div><dt>Production countries</dt><dd>{{ movieProductionCountries|join(', ') }}</dd></div>
                    {% endif %}
                </dl>
                </div>
            </aside>
            <div class="movie-content">
                <div class="movie-rating" id="ratingStars"
                     aria-label="Personal rating">
                    <span id="ratingStarsSpan">
                        {% for i in 1..10 %}
                            <i class="bi bi-star{% if movie.personalRating >= i %}-fill{% endif %}"
                               id="movieRatingStar{{ i }}"
                               data-value="{{ i }}"></i>
                        {% endfor %}
                        {% if currentUserName == routeUsername %}
                            <button type="button" class="btn btn-sm p-0 border-0 align-baseline {{ theme == 'dark' ? 'text-light' : 'text-dark' }} theme-text-color"
                                    onclick="loadRatingModal()" id="editRatingButton" aria-label="Edit rating" title="Edit rating">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                            </button>
                        {% endif %}
                    </span>
                </div>

                <div class="movie-actions">
                    {% if currentUserName == routeUsername %}
                        <button type="button" class="btn {{ theme == 'dark' ? 'btn-light' : 'btn-dark' }}" id="logSpecificMovieButton"
                                onclick="showLogPlayModalWithSpecificMovie({{ movie.tmdbId }}, {{ movie.title|movie_title(movie.originalTitle)|json_encode() }}, {{ movie.releaseDate is not null ? movie.releaseDate|date('Y') : 'null' }})">Add play</button>
                        <button type="button" class="btn {{ theme == 'dark' ? 'btn-outline-light' : 'btn-outline-dark' }}" id="watchlistButton"
                                onclick="toggleWatchlist({{ isOnWatchlist ? 'true' : 'false' }})">{{ isOnWatchlist ? 'Remove from' : 'Add to' }} Watchlist</button>
                    {% endif %}
                </div>
                <div class="movie-secondary-actions">
                    <div id="toggleWatchDatesButtonDiv">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="toggleWatchDatesButton" onclick="toggleWatchDates()"
                                aria-controls="watchDatesListDiv" aria-expanded="false" {% if totalPlays == 0 %}disabled{% endif %}>
                            {{ totalPlays }}x Play{% if totalPlays != 1 %}s{% endif %} · View history
                        </button>
                    </div>
                    {% if currentUserName == routeUsername or selectedUserReview is not null %}
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="reviewButton" data-bs-toggle="modal" data-bs-target="#reviewModal">{{ selectedUserReview is null ? 'Add review' : 'Review' }}</button>
                    {% endif %}
                </div>
                <div class="movie-watch-history" style="display: none;" id="watchDatesListDiv">
                    <ul class="list-group" style="padding-right: 0">
                        {% for watchDate in watchDates|reverse %}
                            <li class="list-group-item {% if currentUserName == routeUsername %}list-group-item-action{% endif %}"
                                style="text-align: center;{% if currentUserName == routeUsername %}cursor: pointer;{% endif %}position:relative;"
                                {% if currentUserName == routeUsername %}onclick="loadWatchDateModal(this)"{% endif %}
                                data-watch-date="{{ watchDate.watched_at is null ? '' : watchDate.watched_at|date(dateFormatPhp) }}"
                                data-play-id="{{ watchDate.id }}"
                                data-comment="{{ watchDate.comment }}"
                                data-position="{{ watchDate.position }}"
                                data-location="{{ watchDate.location_id }}">
                                {{ watchDate.watched_at is null ? 'Unknown date' : watchDate.watched_at|date(dateFormatPhp) }}
                                <span style="position: absolute; right:.7rem; top:50%; transform: translateY(-50%); display: flex; gap: 0.5rem;">
                                    {% if watchDate.comment != '' %}
                                        <i class="bi bi-chat-square-text"></i>
                                    {% endif %}
                                    {% if watchDate.location_id != '' and currentUserLocationsEnabled %}
                                        <i class="bi bi-pin-map-fill"></i>
                                    {% endif %}
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>

                {% if movie.tagline is not empty %}
                    <p class="movie-tagline text-body-secondary fst-italic">{{ movie.tagline }}</p>
                {% endif %}
                <section class="movie-section" aria-labelledby="moviePlotHeading">
                    <h2 id="moviePlotHeading" class="h6 fw-bold">Plot</h2>
                    <p class="movie-overview">{{ movie.overview is not empty ? movie.overview : 'No plot available.' }}</p>
                </section>
                <section class="movie-section" aria-labelledby="movieCastHeading">
                    <h2 id="movieCastHeading" class="h6 fw-bold">Cast</h2>
                    {{ _self.credits(castMembers|slice(0, 40), applicationUrl, routeUsername, displayCharacterNames, 'Cast') }}
                </section>
                <section class="movie-section" aria-labelledby="movieDirectorHeading">
                    <h2 id="movieDirectorHeading" class="h6 fw-bold">Director</h2>
                    {{ _self.credits(directors|slice(0, 25), applicationUrl, routeUsername, false, 'Directors') }}
                </section>
            </div>
        </div>
        {% if currentUserName == routeUsername %}
            {{ include('component/modal-where-to-watch.html.twig') }}
            {{ include('component/modal-edit-rating.html.twig') }}
            {{ include('component/modal-edit-watch-date.html.twig') }}
            {{ include('component/modal-more-options.html.twig') }}
            {% if currentUserIsAdmin == true %}
                {{ include('component/modal-change-movie-poster.html.twig') }}
            {% endif %}
        {% endif %}

        {% if currentUserName == routeUsername or selectedUserReview is not null %}
            {{ include('component/modal-review.html.twig') }}
        {% endif %}

    </main>
{% endblock %}
