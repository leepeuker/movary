<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Movary API</title>
    <link rel="stylesheet" href="{{ vendor_url('swagger-ui/swagger-ui.css') }}"/>
</head>
<body>
<div id="swagger-ui"></div>
<script src="{{ vendor_url('swagger-ui/swagger-ui-bundle.js') }}" crossorigin></script>
<script>
    window.onload = () => {
        window.ui = SwaggerUIBundle({
            url: "{{ openApiJsonUrl }}",
            dom_id: '#swagger-ui',
        });
    };
</script>
</body>
</html>
