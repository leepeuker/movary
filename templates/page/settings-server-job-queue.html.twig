{% extends 'base.html.twig' %}

{% block title %}
    Settings - Job Queue
{% endblock %}

{% block stylesheets %}
    <link href="{{ css_url('settings.css') }}" rel="stylesheet">
{% endblock %}

{% block scripts %}
    <script src="{{ js_url('settings-server-job-queue.js') }}"></script>
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}

        <div style="text-align: center;">
            {{ include('component/settings-nav.html.twig') }}
            {{ include('component/modal-job-details.html.twig') }}
            {{ include('component/modal-job-filters.html.twig') }}
            {{ include('component/modal-create-job.html.twig') }}
            {{ include('component/modal-remove-jobs.html.twig') }}

            <div style="padding-top: 1rem">
                <h5 style="margin-bottom: 1rem">Job Queue</h5>

                <p class="text-muted">
                    View and manage background jobs. Click a job row to view its details or remove it.
                </p>

                <div id="alertJobsDiv"></div>


                <div style="text-align: left">
                    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <select class="form-select" id="jobsPerPage" style="width: 5rem">
                                <option value="20" {{ jobsPerPage == 20 ? 'selected' }}>20</option>
                                <option value="50" {{ jobsPerPage == 50 ? 'selected' }}>50</option>
                                <option value="100" {{ jobsPerPage == 100 ? 'selected' }}>100</option>
                                <option value="250" {{ jobsPerPage == 250 ? 'selected' }}>250</option>
                            </select>
                            <label for="jobsPerPage" class="form-label mb-0">per page</label>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-danger settings-table-action" type="button" data-bs-toggle="modal" data-bs-target="#removeJobsModal" data-bs-title="Remove jobs" aria-label="Remove jobs">
                                <i class="bi bi-trash-fill" aria-hidden="true"></i>
                            </button>
                            <div class="btn-group" role="group" aria-label="Job table actions">
                                <button class="btn btn-primary settings-table-action {{ jobFiltersActive ? 'active' }}" type="button" data-bs-toggle="modal" data-bs-target="#jobFiltersModal" data-bs-title="Filter jobs" aria-label="Filter jobs" aria-pressed="{{ jobFiltersActive ? 'true' : 'false' }}">
                                    <i class="bi bi-filter" aria-hidden="true"></i>
                                </button>
                                <button class="btn btn-primary settings-table-action" type="button" onclick="refreshPage()" data-bs-title="Refresh jobs" aria-label="Refresh jobs" style="border-left-color: #aab0b3">
                                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                                </button>
                                <button class="btn btn-primary settings-table-action" type="button" onclick="showCreateJobModal()" data-bs-title="Create job" aria-label="Create job" style="border-left-color: #aab0b3">
                                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive" style="text-align: center;">
                        <table class="table table-hover" id="jobsTable">
                            <thead>
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">User</th>
                                <th scope="col">Type</th>
                                <th scope="col">Status</th>
                                <th scope="col" data-local-time-zone-label>Updated</th>
                                <th scope="col" data-local-time-zone-label>Created</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for job in jobs %}
                                <tr role="button"
                                    tabindex="0"
                                    aria-label="View details for job {{ job.id }}"
                                    data-job-id="{{ job.id }}"
                                    data-job-user-id="{{ job.userId|default('-') }}"
                                    data-job-user-name="{{ job.userName|default('-') }}"
                                    data-job-type="{{ job.type }}"
                                    data-job-status="{{ job.status }}"
                                    data-job-parameters="{{ job.parameters|json_encode|e('html_attr') }}"
                                    data-job-updated-at="{{ job.updatedAt|default('-') }}"
                                    data-job-created-at="{{ job.createdAt }}"
                                    style="cursor: pointer;">
                                    <td>{{ job.id }}</td>
                                    <td>{{ job.userName|default('-') }}</td>
                                    <td>{{ job.type }}</td>
                                    <td>{{ job.status }}</td>
                                    <td data-utc-date-time="{{ job.updatedAt|default('-') }}">{{ job.updatedAt ? job.updatedAt ~ ' UTC' : '-' }}</td>
                                    <td data-utc-date-time="{{ job.createdAt }}">{{ job.createdAt }} UTC</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {{ include('component/pagination.html.twig', {
                        paginationPath: applicationUrl ~ '/settings/server/job-queue',
                        paginationQuery: paginationQuery,
                    }) }}
                </div>

                {% if jobs|length == 0 %}<p>No jobs in queue</p>{% endif %}

            </div>
        </div>
    </main>
{% endblock %}
