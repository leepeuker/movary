{% extends 'base.html.twig' %}

{% block title %}
    Settings - App
{% endblock %}

{% block stylesheets %}
    <link href="{{ applicationUrl }}/css/settings.css" rel="stylesheet">
{% endblock %}

{% block scripts %}
    <script src="{{ applicationUrl }}/js/settings-server-email.js"></script>
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}

        <div style="text-align: center;">
            {{ include('component/settings-nav.html.twig') }}

            <div style="padding-bottom: 1rem;padding-top: 1rem">
                <h5 style="margin-bottom: 1rem">Email settings</h5>

                <p class="text-muted">Configuration set via environment variables cannot be changed and will be readonly.</p>

                {% if hasApplicationUrl == false %}
                    <div class="alert alert-warning" role="alert">
                        An <a href="{{ applicationUrl }}/settings/server/general" class="alert-link">Application URL</a> is required to enable password resets.
                    </div>
                {% endif %}

                <div style="padding-bottom: 1rem;padding-top: 0.5rem">
                    <input class="form-check-input"
                           type="checkbox"
                           value="1"
                           id="emailSupportEnabledInput"
                           {% if emailEnabled == true %}checked{% endif %}
                           {{ emailEnabledSetInEnv == true ? 'disabled' }}
                           style="margin-right: 0.2rem">
                    <label class="form-check-label" for="emailSupportEnabledInput">Enable email support</label>
                </div>

                {% if emailEnabled == true and smtpConfigured == false %}
                    <div class="alert alert-warning" role="alert">
                        Email support is enabled, but the SMTP configuration is incomplete or invalid.
                    </div>
                {% endif %}

                <fieldset id="smtpSettingsFieldset" {{ emailEnabled == false ? 'disabled' }}>
                    <div class="mb-3">
                        <label for="smtpHostInput" class="form-label">
                            <b>SMTP Host</b>
                        </label>
                        <input type="text"
                               class="form-control"
                               value="{{ smtpHost }}"
                               id="smtpHostInput"
                               style="text-align: center;"
                                {{ smtpHostSetInEnv == true ? 'disabled' }}
                        >
                    </div>

                    <div class="mb-3">
                        <label for="smtpPortInput" class="form-label">
                            <b>SMTP Port</b>
                        </label>
                        <input type="number"
                               min="1"
                               max="65535"
                               class="form-control"
                               value="{{ smtpPort }}"
                               id="smtpPortInput"
                               style="text-align: center;"
                                {{ smtpPortSetInEnv == true ? 'disabled' }}
                        >
                    </div>

                    <div class="mb-3">
                        <label for="smtpEncryptionInput" class="form-label">
                            <b>SMTP Encryption</b>
                        </label>
                        <select class="form-control"
                                id="smtpEncryptionInput"
                                style="text-align: center;"
                                {{ smtpEncryptionSetInEnv == true ? 'disabled' }}
                        >
                            <option value="" {% if smtpEncryption == '' %}selected{% endif %}>None</option>
                            <option value="ssl" {% if smtpEncryption == 'ssl' %}selected{% endif %}>SSL</option>
                            <option value="tls" {% if smtpEncryption == 'tls' %}selected{% endif %}>TLS</option>

                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="smtpFromAddressInput" class="form-label">
                            <b>From Address</b>
                        </label>
                        <input type="email"
                               class="form-control"
                               value="{{ smtpFromAddress }}"
                               id="smtpFromAddressInput"
                               style="text-align: center;"
                                {{ smtpFromAddressSetInEnv == true ? 'disabled' }}
                        >
                    </div>

                    <div style="padding-bottom: 1rem;padding-top: 0.5rem">
                        <input class="form-check-input"
                               type="checkbox"
                               value="1"
                               id="smtpWithAuthenticationInput"
                               {% if smtpWithAuthentication == true %}checked{% endif %}
                                {{ smtpWithAuthenticationSetInEnv == true ? 'disabled' }}
                               style="margin-right: 0.2rem">
                        <label class="form-check-label" for="smtpWithAuthenticationInput">Enable SMTP Authentication</label>
                    </div>

                    <div class="mb-3">
                        <label for="smtpUserInput" class="form-label">
                            <b>SMTP User</b>
                        </label>
                        <input type="text"
                               class="form-control"
                               value="{{ smtpWithAuthentication ? smtpUser : '' }}"
                               data-environment-value="{{ smtpUserSetInEnv ? smtpUser : '' }}"
                               data-set-in-env="{{ smtpUserSetInEnv ? 'true' : 'false' }}"
                               id="smtpUserInput"
                               style="text-align: center;"
                                {{ smtpUserSetInEnv == true or smtpWithAuthentication == false ? 'disabled' }}
                        >
                    </div>

                    <div class="mb-3">
                        <label for="smtpPasswordInput" class="form-label">
                            <b>SMTP Password</b>
                        </label>
                        <input type="password"
                               class="form-control"
                               value=""
                               placeholder="{{ smtpWithAuthentication and smtpPasswordConfigured ? '***' : '' }}"
                               autocomplete="new-password"
                               data-configured="{{ smtpPasswordConfigured ? 'true' : 'false' }}"
                               data-set-in-env="{{ smtpPasswordSetInEnv ? 'true' : 'false' }}"
                               id="smtpPasswordInput"
                               style="text-align: center;"
                                {{ smtpPasswordSetInEnv == true or smtpWithAuthentication == false ? 'disabled' }}
                        >
                    </div>

                </fieldset>

                <div id="alertEmailDiv"></div>

                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-outline-primary" id="emailSettingsTestButton" {{ emailEnabled == false ? 'disabled' }}>Test</button>
                    <button type="button" class="btn btn-primary" id="emailSettingsUpdateButton">Submit</button>
                </div>
            </div>
        </div>

        {{ include('component/modal-test-email.html.twig') }}
    </main>
{% endblock %}
