{% extends 'base.html.twig' %}

{% block title %}
    Settings - Job Schedules
{% endblock %}

{% block stylesheets %}
    <link href="{{ asset_url('css/settings.css') }}" rel="stylesheet">
{% endblock %}

{% block scripts %}
    <script src="{{ asset_url('js/settings-server-job-schedules.js') }}"></script>
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}

        <div style="text-align: center;">
            {{ include('component/settings-nav.html.twig') }}
            {{ include('component/modal-create-job-schedule.html.twig') }}
            {{ include('component/modal-job-schedule-filters.html.twig') }}
            {{ include('component/modal-job-schedule-details.html.twig') }}

            <div style="padding-bottom: 1rem;padding-top: 1rem">
                <h5 style="margin-bottom: 1rem">Job Schedules</h5>

                <p class="text-muted">
                    Create and manage recurring background job schedules. Click a schedule row to view its details, change its status, or delete it.
                </p>

                <div id="alertJobSchedulesDiv"></div>

                <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <select class="form-select" id="jobSchedulesPerPage" style="width: 5rem">
                            <option value="20" {{ jobSchedulesPerPage == 20 ? 'selected' }}>20</option>
                            <option value="50" {{ jobSchedulesPerPage == 50 ? 'selected' }}>50</option>
                            <option value="100" {{ jobSchedulesPerPage == 100 ? 'selected' }}>100</option>
                            <option value="250" {{ jobSchedulesPerPage == 250 ? 'selected' }}>250</option>
                        </select>
                        <label for="jobSchedulesPerPage" class="form-label mb-0">per page</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-danger settings-table-action" id="deleteAllJobSchedulesButton" type="button" onclick="deleteAllJobSchedules()" data-bs-title="Delete all job schedules" aria-label="Delete all job schedules">
                            <i class="bi bi-trash-fill" aria-hidden="true"></i>
                        </button>
                        <div class="btn-group" role="group" aria-label="Job schedule table actions">
                            <button class="btn btn-primary settings-table-action {{ jobScheduleFiltersActive ? 'active' }}" type="button" data-bs-toggle="modal" data-bs-target="#jobScheduleFiltersModal" data-bs-title="Filter job schedules" aria-label="Filter job schedules" aria-pressed="{{ jobScheduleFiltersActive ? 'true' : 'false' }}">
                                <i class="bi bi-filter" aria-hidden="true"></i>
                            </button>
                            <button class="btn btn-primary settings-table-action" type="button" onclick="refreshJobSchedulesPage()" data-bs-title="Refresh job schedules" aria-label="Refresh job schedules" style="border-left-color: #aab0b3">
                                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                            </button>
                            <button class="btn btn-primary settings-table-action" type="button" onclick="showCreateJobScheduleModal()" data-bs-title="Create job schedule" aria-label="Create job schedule" style="border-left-color: #aab0b3">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="table-responsive" style="text-align: center;">
                    <table class="table table-hover" id="jobSchedulesTable">
                        <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">User</th>
                            <th scope="col">Type</th>
                            <th scope="col">Cron expression (UTC)</th>
                            <th scope="col" data-local-time-zone-label>Next run</th>
                            <th scope="col">Status</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for schedule in jobSchedules %}
                            <tr role="button"
                                tabindex="0"
                                aria-label="View details for job schedule {{ schedule.id }}"
                                data-job-schedule-id="{{ schedule.id }}"
                                data-job-schedule-user-id="{{ schedule.userId|default('-') }}"
                                data-job-schedule-user-name="{{ schedule.userName|default('-') }}"
                                data-job-schedule-type="{{ schedule.type }}"
                                data-job-schedule-cron-expression="{{ schedule.cronExpression }}"
                                data-job-schedule-next-run-at="{{ schedule.nextRunAt }}"
                                data-job-schedule-enabled="{{ schedule.enabled ? 'true' : 'false' }}"
                                data-job-schedule-parameters="{{ schedule.parameters|json_encode|e('html_attr') }}"
                                style="cursor: pointer;">
                                <td>{{ schedule.id }}</td>
                                <td>{{ schedule.userName|default('-') }}</td>
                                <td>{{ schedule.type }}</td>
                                <td class="font-monospace">{{ schedule.cronExpression }}</td>
                                <td data-utc-date-time="{{ schedule.nextRunAt }}">{{ schedule.nextRunAt }} UTC</td>
                                <td>{{ schedule.enabled ? 'enabled' : 'disabled' }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                {{ include('component/pagination.html.twig', {
                    paginationPath: applicationUrl ~ '/settings/server/job-schedules',
                    paginationQuery: paginationQuery,
                }) }}

                {% if jobSchedules|length == 0 %}<p>No recurring schedules</p>{% endif %}

            </div>
        </div>
    </main>
{% endblock %}
