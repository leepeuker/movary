{% extends 'base.html.twig' %}

{% block title %}
    Settings - Password Resets
{% endblock %}

{% block stylesheets %}
    <link href="{{ asset_url('css/settings.css') }}" rel="stylesheet">
{% endblock %}

{% block scripts %}
    <script src="{{ asset_url('js/settings-server-password-resets.js') }}"></script>
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}

        <div style="text-align: center;">
            {{ include('component/settings-nav.html.twig') }}
            {{ include('component/modal-password-reset.html.twig') }}

            <div style="padding-bottom: 1rem;padding-top: 1rem">
                <h5 style="margin-bottom: 1rem;">Password Resets</h5>

                <p class="text-muted">Active password reset requests. Reset links and token hashes are never displayed.</p>

                <div id="passwordResetManagementAlerts"></div>

                <div class="d-flex justify-content-between align-items-center gap-3 mb-3 text-start">
                    <div class="d-flex align-items-center gap-2">
                        <select class="form-select" id="passwordResetsPerPage" style="width: 5rem">
                            <option value="20" {{ passwordResetsPerPage == 20 ? 'selected' }}>20</option>
                            <option value="50" {{ passwordResetsPerPage == 50 ? 'selected' }}>50</option>
                            <option value="100" {{ passwordResetsPerPage == 100 ? 'selected' }}>100</option>
                            <option value="250" {{ passwordResetsPerPage == 250 ? 'selected' }}>250</option>
                        </select>
                        <label for="passwordResetsPerPage" class="form-label mb-0">per page</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-danger settings-table-action" type="button" id="revokeAllPasswordResetsButton" onclick="revokeAllPasswordResets()" data-bs-title="Revoke all password resets" aria-label="Revoke all password resets" {{ paginationElements.totalCount == 0 ? 'disabled' }}>
                            <i class="bi bi-trash-fill" aria-hidden="true"></i>
                        </button>
                        <div class="btn-group" role="group" aria-label="Password reset table actions">
                            <button class="btn btn-primary settings-table-action" type="button" onclick="refreshPasswordResetsPage()" data-bs-title="Refresh password resets" aria-label="Refresh password resets">
                                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                            </button>
                            <button class="btn btn-primary settings-table-action" type="button" onclick="showCreatePasswordResetModal()" data-bs-title="Create password reset" aria-label="Create password reset" style="border-left-color: #aab0b3">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover" id="passwordResetsTable">
                        <thead>
                        <tr>
                            <th scope="col">User</th>
                            <th scope="col">Email</th>
                            <th scope="col">Created</th>
                            <th scope="col">Expires</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for reset in passwordResets %}
                            <tr class="password-reset-row"
                                data-user-id="{{ reset.userId }}"
                                data-user-name="{{ reset.name }}"
                                data-user-email="{{ reset.email }}"
                                data-created-at="{{ reset.createdAt }} UTC"
                                data-expires-at="{{ reset.expirationDate }} UTC"
                                tabindex="0"
                                role="button"
                                aria-label="Manage password reset for {{ reset.name }}"
                                style="cursor: pointer">
                                <td>{{ reset.name }}</td>
                                <td>{{ reset.email }}</td>
                                <td>{{ reset.createdAt }} UTC</td>
                                <td>{{ reset.expirationDate }} UTC</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-muted">No active password resets.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                {{ include('component/pagination.html.twig', {
                    paginationPath: applicationUrl ~ '/settings/server/password-resets',
                    paginationQuery: paginationQuery,
                }) }}
            </div>
        </div>
    </main>
{% endblock %}
