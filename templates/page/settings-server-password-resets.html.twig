{% extends 'base.html.twig' %}

{% block title %}
    Settings - Password Resets
{% endblock %}

{% block stylesheets %}
    <link href="{{ applicationUrl }}/css/settings.css" rel="stylesheet">
{% endblock %}

{% block scripts %}
    <script src="{{ applicationUrl }}/js/settings-server-password-resets.js"></script>
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}

        <div style="text-align: center;">
            {{ include('component/settings-nav.html.twig') }}

            <div style="padding-bottom: 1rem;padding-top: 1rem">
                <h5 style="margin-bottom: 1rem;">Password Resets</h5>

                <p class="text-muted">Active password reset requests. Reset links and token hashes are never displayed.</p>

                <div id="passwordResetManagementAlerts"></div>

                <div class="d-flex justify-content-between align-items-center gap-3 mb-3 text-start">
                    <div class="d-flex align-items-center gap-2">
                        <select class="form-select" id="passwordResetsPerPage" style="width: 5rem">
                            <option value="20" {{ passwordResetsPerPage == 20 ? 'selected' }}>20</option>
                            <option value="50" {{ passwordResetsPerPage == 50 ? 'selected' }}>50</option>
                            <option value="100" {{ passwordResetsPerPage == 100 ? 'selected' }}>100</option>
                            <option value="250" {{ passwordResetsPerPage == 250 ? 'selected' }}>250</option>
                        </select>
                        <label for="passwordResetsPerPage" class="form-label mb-0">per page</label>
                    </div>
                    <button class="btn btn-primary" type="button" onclick="refreshPasswordResetsPage()" aria-label="Refresh password resets" title="Refresh password resets">
                        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table" id="passwordResetsTable">
                        <thead>
                        <tr>
                            <th scope="col">User</th>
                            <th scope="col">Email</th>
                            <th scope="col">Created</th>
                            <th scope="col">Expires</th>
                            <th scope="col">Action</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for reset in passwordResets %}
                            <tr>
                                <td>{{ reset.name }}</td>
                                <td>{{ reset.email }}</td>
                                <td>{{ reset.createdAt }} UTC</td>
                                <td>{{ reset.expirationDate }} UTC</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-danger password-reset-revoke-button" data-user-id="{{ reset.userId }}" data-user-name="{{ reset.name }}">Revoke</button>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-muted">No active password resets.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                {{ include('component/pagination.html.twig', {
                    paginationPath: applicationUrl ~ '/settings/server/password-resets',
                    paginationQuery: paginationQuery,
                }) }}

                <div class="d-grid mt-3">
                    <button type="button" class="btn btn-danger" id="revokeAllPasswordResetsButton" data-bs-toggle="modal" data-bs-target="#passwordResetsRevokeAllModal" {{ paginationElements.totalCount == 0 ? 'disabled' }}>Revoke all reset links</button>
                </div>
            </div>

            {{ include('component/modal-password-resets-revoke-all.html.twig') }}
        </div>
    </main>
{% endblock %}
