{% extends 'base.html.twig' %}

{% block title %}
    Settings - Security
{% endblock %}

{% block stylesheets %}
    <link href="{{ asset_url('css/settings.css') }}" rel="stylesheet">
{% endblock %}

{% block scripts %}
    <script src="{{ asset_url('js/qrcode.min.js') }}"></script>
    <script src="{{ asset_url('js/settings-account-security.js') }}"></script>
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}

        <div style="text-align: center;">
            {{ include('component/settings-nav.html.twig') }}

            <div class="account-security-section" id="accountEmailSettings"
                 data-current-email="{{ email }}"
                 data-pending-email="{{ pendingEmail|default('') }}"
                 data-email-verification-enabled="{{ emailVerificationEnabled ? 'true' : 'false' }}"
                 style="padding-top: 1rem">
                <h5>Email address</h5>

                <div class="border rounded p-3 text-start">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                        <div class="text-break">
                            <div class="fw-bold" id="currentEmailAddress">{{ email }}</div>
                            <div class="form-text">Current login email</div>
                            <div class="mt-2 {{ pendingEmail ? '' : 'd-none' }}" id="pendingEmailSummary">
                                <span class="badge text-bg-warning">Awaiting verification</span>
                                <span class="ms-1" id="pendingEmailAddress">{{ pendingEmail }}</span>
                                <div class="form-text" id="pendingEmailDescription">
                                    {% if pendingEmail %}
                                        {% if emailVerificationEnabled %}
                                            Verify this address before it replaces your current login email.
                                        {% else %}
                                            Email verification is unavailable. Change the email again to apply it immediately.
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 flex-shrink-0">
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    id="changeEmailButton"
                                    {% if coreAccountChangesDisabled == true %}disabled{% endif %}>
                                Change email
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary {{ pendingEmail and emailVerificationEnabled ? '' : 'd-none' }}"
                                    id="resendPendingEmailButton"
                                    {% if coreAccountChangesDisabled == true %}disabled{% endif %}>
                                Resend
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger {{ pendingEmail ? '' : 'd-none' }}"
                                    id="cancelPendingEmailButton"
                                    {% if coreAccountChangesDisabled == true %}disabled{% endif %}>
                                Cancel change
                            </button>
                        </div>
                    </div>

                    <div class="border-top mt-3 pt-3 d-none" id="emailChangeForm">
                        <div class="mb-3">
                            <label for="emailInput" class="form-label"><b>New email address</b> <span class="text-danger">*</span></label>
                            <input type="email"
                                   class="form-control"
                                   value="{{ pendingEmail|default(email) }}"
                                   required
                                   id="emailInput"
                                   autocomplete="email"
                                   {% if coreAccountChangesDisabled == true %}disabled{% endif %}>
                        </div>

                        <div class="mb-3">
                            <label for="emailCurrentPasswordInput" class="form-label"><b>Current password</b> <span class="text-danger">*</span></label>
                            <input type="password"
                                   class="form-control"
                                   required
                                   id="emailCurrentPasswordInput"
                                   autocomplete="current-password"
                                   aria-describedby="emailCurrentPasswordHelp"
                                   {% if coreAccountChangesDisabled == true %}disabled{% endif %}>
                            <div id="emailCurrentPasswordHelp" class="form-text">Confirm your password to change your login email.</div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" id="cancelEmailEditButton">Cancel</button>
                            <button type="button"
                                    class="btn btn-primary"
                                    id="accountEmailUpdateButton"
                                    {% if coreAccountChangesDisabled == true %}disabled{% endif %}>
                                {{ emailVerificationEnabled ? 'Send verification' : 'Update email' }}
                            </button>
                        </div>
                    </div>
                </div>

                <div class="mt-3" id="alertAccountEmailDiv"></div>
            </div>

            <hr>

            <div class="account-security-section">
                <h5>Password change</h5>
                <div class="mb-3">
                    <label for="currentPassword" class="form-label"><b>Current password</b> <span class="text-danger">*</span></label>
                    <input type="password"
                           class="form-control"
                           id="currentPassword"
                           required
                           {% if coreAccountChangesDisabled == true %}disabled{% endif %}
                           style="text-align: center;">
                    <div id="currentPassword" class="form-text">Enter your current password</div>
                </div>

                <div class="mb-3">
                    <label for="newPassword" class="form-label"><b>New password</b> <span class="text-danger">*</span></label>
                    <input type="password"
                           class="form-control"
                           id="newPassword"
                           required
                           minlength="{{ passwordMinimumLength }}"
                           {% if coreAccountChangesDisabled == true %}disabled{% endif %}
                           style="text-align: center;">
                    <div id="currentPassword" class="form-text">Must be at least {{ passwordMinimumLength }} characters long</div>
                </div>

                <div class="mb-3">
                    <label for="newPasswordRepeat" class="form-label"><b>Repeat new password</b> <span class="text-danger">*</span></label>
                    <input type="password"
                           class="form-control"
                           id="newPasswordRepeat"
                           required minlength="{{ passwordMinimumLength }}"
                           {% if coreAccountChangesDisabled == true %}disabled{% endif %}
                           style="text-align: center;">
                    <div id="newPasswordRepeat" class="form-text">Must match new password</div>
                </div>

                <div id="alertChangePasswordDiv"></div>

                <button class="btn btn-primary"
                        type="button"
                        id="changePasswordUpdateButton"
                        {% if coreAccountChangesDisabled == true %}disabled{% endif %}>
                    Submit
                </button>
            </div>

            <hr>

            <h5 style="margin-bottom: .7rem">Two-Factor Authentication</h5>
            {% if twoFactorAuthenticationEnabled == true %}
                <div class="alert alert-success alert-dismissible" role="alert" style="margin-left: 5%;margin-right: 5%;margin-bottom: 0.7rem!important;margin-top: 0">
                    Two-Factor authentication has been enabled.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% elseif twoFactorAuthenticationDisabled == true %}
                <div class="alert alert-success alert-dismissible" role="alert" style="margin-left: 5%;margin-right: 5%;margin-bottom: 0.7rem!important;margin-top: 1rem">
                    Two-Factor authentication has been disabled.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endif %}
            <div id="twoFactorAuthenticationDisableAlertDiv"></div>
            <div class="mb-3">
                {% if totpEnabled == true %}
                    <button type="button" class="btn btn-danger" onclick="disableTOTP(this)">Disable Two-Factor Authentication
                    </button>
                {% else %}
                    <button type="button" class="btn btn-primary" onclick="showAddTwoFactorAuthenticationModal()">Enable Two-Factor Authentication</button>
                {% endif %}
            </div>
        </div>
    </main>
    {{ include('component/modal-add-two-factor-authentication.html.twig') }}
{% endblock %}
