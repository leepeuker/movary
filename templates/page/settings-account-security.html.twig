{% extends 'base.html.twig' %}

{% block title %}
    Settings - Security
{% endblock %}

{% block stylesheets %}
    <link href="{{ asset_url('css/settings.css') }}" rel="stylesheet">
{% endblock %}

{% block scripts %}
    <script src="{{ asset_url('vendor/qrcode/qrcode.min.js') }}"></script>
    <script src="{{ asset_url('js/settings-account-security.js') }}"></script>
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}

        <div style="text-align: center;">
            {{ include('component/settings-nav.html.twig') }}

            <div id="accountSecuritySettings"
                 data-current-email="{{ email }}"
                 data-pending-email="{{ pendingEmail|default('') }}"
                 data-email-verification-enabled="{{ emailVerificationEnabled ? 'true' : 'false' }}"
                 style="padding-top: 1rem">
                <h5>Security settings</h5>
                <p>Update the email address and password used to sign in.</p>

                <div class="mb-3">
                    <label for="emailInput" class="form-label"><b>Email address</b> <span class="text-danger">*</span></label>
                    <input type="email"
                           class="form-control"
                           value="{{ email }}"
                           required
                           id="emailInput"
                           autocomplete="email"
                           {% if coreAccountChangesDisabled == true or pendingEmail %}disabled{% endif %}
                           style="text-align: center;">
                    <div class="form-text">Your login email</div>
                    <div class="mt-2 {{ pendingEmail ? '' : 'd-none' }}" id="pendingEmailSummary">
                        <div class="form-text text-warning">
                            Pending verification: <span id="pendingEmailAddress">{{ pendingEmail }}</span>
                        </div>
                        <div class="d-flex flex-wrap justify-content-center gap-2 mt-2">
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary {{ emailVerificationEnabled ? '' : 'd-none' }}"
                                    id="resendPendingEmailButton"
                                    {% if coreAccountChangesDisabled == true %}disabled{% endif %}>
                                Resend
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    id="cancelPendingEmailButton"
                                    {% if coreAccountChangesDisabled == true %}disabled{% endif %}>
                                Cancel
                            </button>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="currentPassword" class="form-label"><b>Current password</b> <span class="text-danger">*</span></label>
                    <input type="password"
                           class="form-control"
                           id="currentPassword"
                           autocomplete="current-password"
                           {% if coreAccountChangesDisabled == true %}disabled{% endif %}
                           style="text-align: center;">
                    <div class="form-text">Required to save email or password changes</div>
                </div>

                <div class="mb-3">
                    <label for="newPassword" class="form-label"><b>New password</b></label>
                    <input type="password"
                           class="form-control"
                           id="newPassword"
                           minlength="{{ passwordMinimumLength }}"
                           autocomplete="new-password"
                           {% if coreAccountChangesDisabled == true %}disabled{% endif %}
                           style="text-align: center;">
                    <div class="form-text">Optional; must be at least {{ passwordMinimumLength }} characters long</div>
                </div>

                <div class="mb-3">
                    <label for="newPasswordRepeat" class="form-label"><b>Repeat new password</b></label>
                    <input type="password"
                           class="form-control"
                           id="newPasswordRepeat"
                           minlength="{{ passwordMinimumLength }}"
                           autocomplete="new-password"
                           {% if coreAccountChangesDisabled == true %}disabled{% endif %}
                           style="text-align: center;">
                    <div class="form-text">Required only when setting a new password</div>
                </div>

                <div id="alertAccountSecurityDiv"></div>

                <button class="btn btn-primary"
                        type="button"
                        id="accountSecurityUpdateButton"
                        {% if coreAccountChangesDisabled == true %}disabled{% endif %}>
                    Submit
                </button>
            </div>

            <hr>

            <h5 style="margin-bottom: .7rem">Two-Factor Authentication</h5>
            {% if twoFactorAuthenticationEnabled == true %}
                <div class="alert alert-success alert-dismissible" role="alert" style="margin-left: 5%;margin-right: 5%;margin-bottom: 0.7rem!important;margin-top: 0">
                    Two-Factor authentication has been enabled.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% elseif twoFactorAuthenticationDisabled == true %}
                <div class="alert alert-success alert-dismissible" role="alert" style="margin-left: 5%;margin-right: 5%;margin-bottom: 0.7rem!important;margin-top: 1rem">
                    Two-Factor authentication has been disabled.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endif %}
            <div id="twoFactorAuthenticationDisableAlertDiv"></div>
            <div class="mb-3">
                {% if totpEnabled == true %}
                    <button type="button" class="btn btn-danger" onclick="disableTOTP(this)">Disable Two-Factor Authentication
                    </button>
                {% else %}
                    <button type="button" class="btn btn-primary" onclick="showAddTwoFactorAuthenticationModal()">Enable Two-Factor Authentication</button>
                {% endif %}
            </div>
        </div>
    </main>
    {{ include('component/modal-add-two-factor-authentication.html.twig') }}
{% endblock %}
