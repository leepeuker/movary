{% extends 'base.html.twig' %}

{% block title %}
    Forgot password
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset_url('css/password-reset.css') }}">
{% endblock %}

{% block body %}
    <script>
        if ("{{ theme }}" === 'dark') document.getElementsByTagName('body')[0].classList.add('bg-dark')
    </script>
    <main role="main" class="form-password-reset w-100 m-auto text-center">
        <h1 class="text-{{ theme == 'dark' ? 'light' : 'dark' }}">Forgot password</h1>
        {% if requestSubmitted == true %}
            <div class="alert alert-success" role="alert">
                If an account exists for that email address, a password reset email has been scheduled.
            </div>
            {% else %}
            <form action="{{ applicationUrl }}/forgot-password" method="post">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <div class="form-floating mb-3">
                    <input type="email" name="email" class="form-control" id="passwordResetEmail"
                           placeholder="name@example.com" autocomplete="email" required>
                    <label for="passwordResetEmail">Email address</label>
                </div>
                <button class="w-100 btn btn-primary mb-3" type="submit">Send reset link</button>
            </form>
        {% endif %}
        <a href="{{ applicationUrl }}/login">Back to login</a>
    </main>
{% endblock %}
