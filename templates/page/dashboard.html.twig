{% extends 'base.html.twig' %}

{% block title %}
    {{ routeUsername }}'s dashboard
{% endblock %}

{% block stylesheets %}
    <link href="{{ asset_url('css/dashboard.css') }}" rel="stylesheet">
{% endblock %}

{% block scripts %}
    <script src="{{ asset_url('js/dashboard.js') }}"></script>
    <script src="{{ asset_url('js/component/user-select.js') }}"></script>
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}
        <div style="text-align: center;padding-bottom: 1rem">
            {{ include('component/user-select.html.twig') }}

            <h2 class="overview-title">All-time overview</h2>
            <div class="overview-grid {{ theme == 'dark' ? 'text-light' : 'text-dark' }} theme-text-color">
                <div class="overview-stat card">
                    <span class="stat-value">{{ totalPlayCount|number_format(0, '.', ',') }}</span>
                    <span class="stat-description">Total plays</span>
                </div>
                <div class="overview-stat card">
                    <span class="stat-value">{{ uniqueMoviesCount|number_format(0, '.', ',') }}</span>
                    <span class="stat-description">Unique movies</span>
                </div>
                <div class="overview-stat card">
                    <span class="stat-value">{{ totalHoursWatched|number_format(0, '.', ',') }}</span><span class="stat-unit">h</span>
                    <span class="stat-description">Hours watched</span>
                </div>
                <div class="overview-stat card">
                    <span class="stat-value">{{ averagePlaysPerDay }}</span>
                    <span class="stat-description">Plays per day</span>
                </div>
                <div class="overview-stat card">
                    <span class="stat-value">{{ averagePersonalRating }}</span><span class="stat-unit">/ 10</span>
                    <span class="stat-description">Average rating</span>
                </div>
                <div class="overview-stat card">
                    <span class="stat-value">{{ averageRuntime }}</span><span class="stat-unit">min</span>
                    <span class="stat-description">Average runtime</span>
                </div>
            </div>

            <div class="list-group" id="dashboardRows" data-username="{{ routeUsername }}">
                {% for dashboardRow in dashboardRows %}
                    {% if dashboardRow.isVisible %}
                        {% if dashboardRow.isExtended %}
                            {{ include('component/dashboard/row.html.twig') }}
                        {% else %}
                            {% import 'component/dashboard/row-item-toggle.html.twig' as rowItemToggle %}
                            {{ rowItemToggle.create(dashboardRow) }}
                            <li class="list-group-item dashboardRowPlaceholder inactiveItem py-4">
                                <div class="d-flex justify-content-center align-items-center">
                                    <div class="spinner-border text-secondary" role="status">
                                        <span class="visually-hidden">Loading {{ dashboardRow.name }}</span>
                                    </div>
                                </div>
                            </li>
                        {% endif %}
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </main>
{% endblock %}
