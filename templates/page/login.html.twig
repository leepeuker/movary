{% extends 'base.html.twig' %}

{% block title %}
    Login
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset_url('css/login.css') }}">
{% endblock %}

{% block scripts %}
    <script src="{{ asset_url('js/login.js') }}"></script>
{% endblock %}

{% block body %}
    <script>
        if ("{{ theme }}" === 'dark') document.getElementsByTagName('body')[0].classList.add('bg-dark')
    </script>
        <main role="main" class="form-signin w-100 m-auto text-center">
            <div id="loginForm">
                <h1 id="header" class="text-{{ theme == 'dark' ? 'light' : 'dark' }}" style="margin-bottom: 1rem">{{ applicationName ?? 'Movary' }}</h1>
                <div class="form-floating">
                    <input type="email" value="{{ defaultEmail }}" class="form-control text-{{ theme == 'dark' ? 'light' : 'dark' }}" id="email"
                        placeholder="name@example.com" onkeydown="submitCredentialsOnEnter(event)" required>
                    <label for="email">Email address</label>
                </div>
                <div class="form-floating">
                    <input type="password" value="{{ defaultPassword }}" class="form-control text-{{ theme == 'dark' ? 'light' : 'dark' }}" id="password"
                        placeholder="Password" onkeydown="submitCredentialsOnEnter(event)" required>
                    <label for="password">Password</label>
                </div>

                <div class="d-flex align-items-center justify-content-between my-3">
                    <div class="form-check mb-0 text-start">
                        <input class="form-check-input" type="checkbox" id="rememberMe" value="true" {{ defaultRememberMe == 'true' ? 'checked' : '' }}>
                        <label class="form-check-label small text-{{ theme == 'dark' ? 'light' : 'dark' }}" for="rememberMe">
                            Remember me
                        </label>
                    </div>
                    {% if passwordResetAvailable == true %}
                        <a class="small" href="{{ applicationUrl }}/forgot-password">Forgot password?</a>
                    {% endif %}
                </div>

                <div id="loginErrors"></div>

                <div class="alert alert-warning d-none" role="alert" id="emailVerificationRequiredAlert">
                    <p>Verify your email address before signing in.</p>
                    <form action="{{ applicationUrl }}/verify-email/resend" method="post">
                        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                        <input type="hidden" name="email" id="emailVerificationEmail">
                        <button class="btn btn-outline-primary" type="submit">Resend verification</button>
                    </form>
                </div>

                {% if passwordChanged == true %}
                    <div class="alert alert-success" role="alert">
                        Your password was changed. Please sign in again.
                    </div>
                {% endif %}

                {% if emailVerified == true %}
                    <div class="alert alert-success" role="alert">
                        Your email address was verified successfully. You can now sign in.
                    </div>
                {% endif %}

                {% if registrationPendingApproval == true or registrationEmailVerificationRequired == true %}
                    <div class="alert alert-success" role="alert">
                        Your account was created.
                        {% if registrationEmailVerificationRequired == true %}
                            Verify your email address before signing in.
                        {% endif %}
                        {% if registrationPendingApproval == true %}
                            An administrator must enable your account before you can sign in.
                        {% endif %}
                    </div>
                {% endif %}

                {% if redirect != false %}
                    <div class="alert alert-danger" role="alert" id="forbiddenPageAlert">
                        Sign in to access page
                    </div>
                    <input type="hidden" value="{{ redirect }}" name="redirect" />
                {% endif %}
                <button class="w-100 btn btn-lg btn-primary" type="button" onclick="submitCredentials()">Sign in</button>
                {% if registrationEnabled == true %}
                    <p class="small mt-3 mb-0">
                        <a href="{{ applicationUrl }}/create-user">Create account</a>
                    </p>
                {% endif %}
            </div>
            <div id="totpForm" class="d-none">
                <p style="margin-bottom: 0">Enter the 6 digit verification code from your authenticator app.</p>
                <input type="text"
                    class="form-control form-control-lg text-{{ theme == 'dark' ? 'light' : 'dark' }}"
                    placeholder="Verification code"
                    maxlength="6"
                    autocomplete="off"
                    style="margin-bottom: .7rem;margin-top: .7rem"
                    id="totpCode"
                    onkeydown="submitCredentialsOnEnter(event)"
                    required>
                <div id="totpErrors"></div>
                <button class="w-100 btn btn-lg btn-primary mb-3" type="button" style="margin-bottom: .7rem!important;" onclick="submitCredentials()">Continue</button>
                <a href="{{ applicationUrl }}/">Back</a>
            </div>
        </main>
{% endblock %}
