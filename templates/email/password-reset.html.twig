<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset your {{ applicationName|e('html') }} password</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f4f4; color: #212529; font-family: Arial, sans-serif;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color: #f4f4f4; padding: 32px 16px;">
    <tr>
        <td align="center">
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width: 600px; background-color: #ffffff; border-radius: 6px; padding: 32px;">
                <tr>
                    <td>
                        <h1 style="margin: 0 0 24px; font-size: 24px;">Reset your {{ applicationName|e('html') }} password</h1>
                        <p style="margin: 0 0 24px; line-height: 1.5;">
                            A password reset was requested for your account. Use the button below to choose a new password.
                        </p>
                        <p style="margin: 0 0 24px; text-align: center;">
                            <a href="{{ resetUrl|e('html') }}" style="display: inline-block; padding: 12px 24px; border-radius: 4px; background-color: #0d6efd; color: #ffffff; font-weight: bold; text-decoration: none;">Reset password</a>
                        </p>
                        <p style="margin: 0 0 16px; line-height: 1.5;">
                            This link expires in {{ expirationTimeInMinutes }} minutes and can only be used once.
                        </p>
                        <p style="margin: 0 0 24px; line-height: 1.5;">
                            If you did not request a password reset, you can ignore this email. Your password will not change.
                        </p>
                        <hr style="border: 0; border-top: 1px solid #dee2e6; margin: 24px 0;">
                        <p style="margin: 0 0 8px; color: #6c757d; font-size: 13px; line-height: 1.5;">
                            If the button does not work, copy and paste this link into your browser:
                        </p>
                        <p style="margin: 0; font-size: 13px; line-height: 1.5; overflow-wrap: anywhere;">
                            <a href="{{ resetUrl|e('html') }}" style="color: #0d6efd;">{{ resetUrl|e('html') }}</a>
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
