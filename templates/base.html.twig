<!DOCTYPE html>
<html id="html" data-bs-theme="{{ theme }}" data-movie-list-view="posters">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="{{ csrfToken }}">
    <link rel="canonical" href="{{ applicationUrl }}{{ canonicalPath }}{{ canonicalExtra }}" />

    <title>{% apply trim %}{% block title %}Movary{% endblock %}{% endapply %} | {{ applicationName }}</title>
    <link rel="shortcut icon" href="{{ applicationUrl }}/images/favicon.ico" type="image/x-icon">

    <meta property="og:title" content="{{ block('title')|trim }} | {{ applicationName }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ applicationUrl }}{{ canonicalPath }}{{ canonicalExtra }}" />
    <meta property="og:image" content="{% block ogImage %}{{ applicationUrl }}/images/movary-logo-512x512.png{% endblock %}" />
    <meta property="og:description" content="Self hosted web app to track and rate your watched movies" />

    <link href="{{ vendor_url('bootstrap/bootstrap.min.css') }}" rel="stylesheet">
    <link rel="manifest" href="{{ applicationUrl }}/manifest.json">

    <script src="{{ js_url('movie-list-view-preference.js') }}"></script>

    <meta name="theme-color" content="white">
    <link rel="stylesheet" href="{{ vendor_url('bootstrap-icons/bootstrap-icons.css') }}">
    <link rel="stylesheet" href="{{ vendor_url('datepicker/datepicker.min.css') }}">
    <link rel="stylesheet" href="{{ css_url('global.css') }}">
{% block stylesheets %}{% endblock %}
</head>
<body>
<script>0</script>

<input value="{{ dateFormatJavascript }}" id="dateFormatJavascript" hidden>
<input value="{{ dateFormatPhp }}" id="dateFormatPhp" hidden>
<input type="hidden" id="currentUserName" value="{{ currentUserName }}">

{% block body %}{% endblock %}

{{ include('component/modal-dialog.html.twig') }}

<script>
    window.APPLICATION_URL = "{{ applicationUrl }}";
    window.MOVIE_TITLE_DISPLAY = {{ movieTitleDisplay|json_encode|raw }};
    window.SERVICE_WORKER_URL = "{{ applicationUrl }}/serviceWorker.js";
    window.PASSWORD_MIN_LENGTH = {{ passwordMinimumLength }};
</script>
<script src="{{ vendor_url('bootstrap/bootstrap.bundle.min.js') }}"></script>
<script src="{{ vendor_url('datepicker/datepicker-full.min.js') }}"></script>
<script src="{{ js_url('app.js') }}"></script>

{% block scripts %}{% endblock %}
</body>
</html>
