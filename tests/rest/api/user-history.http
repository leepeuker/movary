GET http://127.0.0.1/api/v1/users/{{username}}/plays?search=Matrix&limit=10
Accept: application/json
X-Movary-Token: {{xMovaryToken}}

####

POST http://127.0.0.1/api/v1/users/{{username}}/plays
Content-Type: application/json
X-Movary-Token: {{xMovaryToken}}

{"movaryId":1,"watchedAt":"2011-05-06","comment":"A play"}

####

GET http://127.0.0.1/api/v1/users/{{username}}/plays/{{playId}}
Accept: application/json
X-Movary-Token: {{xMovaryToken}}

####

PUT http://127.0.0.1/api/v1/users/{{username}}/plays/{{playId}}
Content-Type: application/json
X-Movary-Token: {{xMovaryToken}}

{"watchedAt":"2011-05-06","position":1,"comment":"Updated play","locationId":null}

####

DELETE http://127.0.0.1/api/v1/users/{{username}}/plays/{{playId}}
X-Movary-Token: {{xMovaryToken}}
